mainmenu "hw-testing-rack power hub"

menu "Power hub"

config HUB_PD_EPR
	bool "Ask for 28 V EPR when the charger offers it"
	default y
	help
	  The CH224A asks for 9 V at plug-in (its CFG1 resistor); the
	  firmware then asks for 28 V EPR when the charger offers it (PDO 1's
	  EPR Mode Capable bit, or tried when the sink shows no offers), and
	  for 20 V otherwise or when VBUS does not follow.  Never above 28 V:
	  the board's regulator node caps every request.  The choice can be
	  changed at run time (shell, web page) and is saved.

config HUB_VBUS_MIN_MV
	int "VBUS above which the PD sink is powered and talked to (mV)"
	default 4500

config HUB_PD_ADAPTIVE
	bool "Start at 20 V, move to 28 V EPR once a row draws more"
	help
	  Off (the default): 28 V EPR when the charger offers it, else 20 V.
	  On: 20 V first, then 28 V EPR (a PD transition: VRACK does not
	  drop) once any row's IMON reaches CONFIG_HUB_PD_ADAPTIVE_MA; back
	  to 20 V only when VBUS goes.  Meant for a hub whose CH224A sees
	  close to its 32 V rating on VHV at 28 V (bring-up).

config HUB_PD_ADAPTIVE_MA
	int "Row current that moves an adaptive hub to 28 V EPR (mA)"
	default 1200
	help
	  Used with HUB_PD_ADAPTIVE.  The eFuses limit a row at 1.6 A.

config HUB_PD_REQUEST_MS
	int "VBUS must reach a requested voltage within this long (ms)"
	default 3000
	help
	  The CH224A cannot report the contract: a request counts once the
	  sink says PD, PG is low and VBUS_SENSE reads the voltage asked for.
	  A 28 V request that VBUS does not follow in time falls back to
	  20 V; a 20 V one is reported, and the rows stay off below
	  CONFIG_HUB_ROWS_MIN_MV.

config HUB_CONTRACT_SETTLE_MS
	int "A contract must hold this long before rows are turned on (ms)"
	default 500

config HUB_ROWS_MIN_MV
	int "Contracts below this never power the rows (mV)"
	default 15000
	help
	  The CH224A starts at 9 V (CFG1), and stays there until the firmware
	  asks for more: such a contract never counts as final, the rows stay
	  off (their eFuses are locked out below 15 V anyway) and come on
	  once the contract is up.  There is no input switch: VBUS is VRACK.

config HUB_ROW_STAGGER_MS
	int "Delay between two rows turned on one after the other (ms)"
	default 300

config HUB_ROW_BOOT_MS
	int "Wait after a row comes on before enumerating its nodes (ms)"
	default 2000
	help
	  The nodes boot from the row's VRACK; the enumeration waits for
	  them.  A node that boots later asks by itself.

config HUB_ROW_FLT_BLANK_MS
	int "A row's FLT is ignored this long after the row is turned on (ms)"
	default 10
	help
	  The TPS2660 asserts FLT in shutdown and during its soft start
	  (about 5 ms at 28 V): FLT counts only while the row is on and this
	  long after it was turned on.  The red LEDs are fed from ROW_EN, so
	  an off row shows none either.

config HUB_ROW_CYCLE_MS
	int "Default off time of a row power cycle (ms)"
	default 2000

config HUB_BUDGET_MARGIN_PCT
	int "Share of the contract kept free below the rows' budget (%)"
	default 10
	range 0 50
	help
	  The rows may draw the contract's current (the CH224A's granted
	  current: 5 A for 20 V x 5 A or 28 V x 5 A EPR, 3 A with a 3 A
	  cable), or a cap set by hand, less this share: the hub's own draw
	  and IMON's error.  Above it, rows are shed in the shed order before
	  the charger's overcurrent protection cuts the whole rack.  Set at
	  run time with "hub budget margin" (saved).

config HUB_SHED_HOLD_MS
	int "Over the budget this long before a row is shed (ms)"
	default 1000

config HUB_SHED_FAST_MS
	int "Over the contract itself this long before a row is shed (ms)"
	default 250
	help
	  Past the contract's current a charger may cut its output: shed
	  sooner than CONFIG_HUB_SHED_HOLD_MS (the rows are sampled every
	  250 ms).

config HUB_RESTORE_HOLD_S
	int "Contract stable and room to spare this long before a shed row comes back (s)"
	default 10

config HUB_RESTORE_MARGIN_MA
	int "Room needed beyond the most a shed row drew before it comes back (mA)"
	default 200

config HUB_RESTORE_FLAP_S
	int "A row shed again within this long of coming back waits twice as long (s)"
	default 60

config HUB_RESTORE_HOLD_MAX_S
	int "The longest a shed row's restore hold grows to (s)"
	default 600

config HUB_EVENTS
	int "Events kept for the web page and the shell"
	default 32

config HUB_HTTP_PORT
	int "TCP port of the web page, JSON API and /metrics"
	default 80
	range 1 65535

module = HUB
module-str = power hub
source "subsys/logging/Kconfig.template.log_config"

endmenu

source "Kconfig.zephyr"
