/*
 * The front display on the bay node: a study, revision A has no connector
 * for it.  The panel on SPI2 with the camera, CS on IO5 and DC on IO6, the
 * node's two free pins (electronics/bay-node/design.py); the panel's and
 * the touch controller's resets on the node's EN, the backlight always on,
 * the touch controller polled on I2C0 (address 0x15).  Panel settings: the
 * TL019FQV01 shield's, the same 1.9" ST7789V glass, landscape.
 *
 * SPDX-License-Identifier: Apache-2.0
 */

#include <zephyr/dt-bindings/mipi_dbi/mipi_dbi.h>
#include <zephyr/dt-bindings/display/panel.h>

/ {
	chosen {
		zephyr,display = &front_lcd;
	};

	mipi_dbi_front {
		compatible = "zephyr,mipi-dbi-spi";
		spi-dev = <&spi2>;
		dc-gpios = <&gpio0 6 GPIO_ACTIVE_HIGH>;
		write-only;
		#address-cells = <1>;
		#size-cells = <0>;

		front_lcd: st7789v@1 {
			compatible = "sitronix,st7789v";
			reg = <1>;
			mipi-max-frequency = <10000000>;
			width = <320>;
			height = <170>;
			x-offset = <0>;
			y-offset = <35>;
			vcom = <0x2b>;
			gctrl = <0x35>;
			vrhs = <0x0f>;
			vdvs = <0x20>;
			mdac = <0x60>;
			gamma = <0x01>;
			pixel-format = <PANEL_PIXEL_FORMAT_RGB_565>;
			lcm = <0x2c>;
			porch-param = [0c 0c 00 33 33];
			cmd2en-param = [5a 69 02 01];
			pwctrl1-param = [52 a1];
			pvgam-param = [d0 00 02 07 0b 1a 31 54 40 29 12 12 12 17];
			nvgam-param = [d0 00 02 07 05 15 2d 44 44 1c 18 16 1c 1d];
			ram-param = [00 f8];
			rgb-param = [cd 08 14];
			mipi-mode = "MIPI_DBI_MODE_SPI_4WIRE";
		};
	};

	lvgl_pointer {
		compatible = "zephyr,lvgl-pointer-input";
		input = <&front_touch>;
	};
};

&spi2 {
	cs-gpios = <&gpio0 8 GPIO_ACTIVE_LOW>, <&gpio0 5 GPIO_ACTIVE_LOW>;
};

&i2c0 {
	front_touch: touch@15 {
		compatible = "hynitron,cst8xx";
		reg = <0x15>;
		/* The panel is portrait: landscape swaps the touch axes */
		swapped-x-y;
	};
};
