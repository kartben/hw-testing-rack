# hw-testing-rack: drivers and libraries shared by the bay node and the power hub
# SPDX-License-Identifier: Apache-2.0

menu "hw-testing-rack"

config MFD_AP33772S
	bool "Diodes AP33772S USB PD 3.1 sink (MFD)"
	default y
	depends on DT_HAS_DIODES_AP33772S_ENABLED
	depends on MFD
	select I2C
	help
	  I2C access, status events and source capabilities of the AP33772S;
	  its children are a regulator (the contract) and a sensor.

config MFD_AP33772S_INIT_PRIORITY
	int "AP33772S MFD init priority"
	default 80
	depends on MFD_AP33772S

config REGULATOR_AP33772S
	bool "Diodes AP33772S USB PD contract as a regulator"
	default y
	depends on DT_HAS_DIODES_AP33772S_REGULATOR_ENABLED
	depends on REGULATOR
	depends on MFD_AP33772S

config REGULATOR_AP33772S_INIT_PRIORITY
	int "AP33772S regulator init priority"
	default 86
	depends on REGULATOR_AP33772S

config SENSOR_AP33772S
	bool "Diodes AP33772S measurements (VOUT, current, temperature)"
	default y
	depends on DT_HAS_DIODES_AP33772S_SENSOR_ENABLED
	depends on SENSOR
	depends on MFD_AP33772S

config HWTR_RACK_PROTO
	bool "Rack bus protocol (docs/rack-protocol.md)"
	help
	  Frame encoding and decoding, shared by the hub and the nodes.

config HWTR_RACK_HUB
	bool "Rack bus: the hub's side (enumeration, node table)"
	select HWTR_RACK_PROTO

config HWTR_RACK_NODE
	bool "Rack bus: a node's side (POS token, address, heartbeat)"
	select HWTR_RACK_PROTO

config HWTR_NET
	bool "Wi-Fi station, hostname <prefix>-<id> and reconnection"
	depends on WIFI && WIFI_CREDENTIALS && NET_HOSTNAME_ENABLE

config HWTR_ACL
	bool "Access rules, lease, SHA-256 and HMAC (plain C)"

config HWTR_ADMIN
	bool "Admin key: claim by a button press, signed requests"
	select HWTR_ACL
	help
	  The device's admin key, its first claim confirmed by physical
	  presence (a button press or the local shell), and the check of
	  admin requests signed with it (X-Bay-Auth: nonce and HMAC-SHA256).

config HWTR_ADMIN_CLAIM_S
	int "Time to press the button after a claim request (s)"
	default 60
	depends on HWTR_ADMIN

config HWTR_JPEG
	bool "Where a JPEG ends, in a stream that arrives in pieces (plain C)"

config HWTR_IMG
	bool "MCUboot image header and TLVs, read as they stream in (plain C)"

config HWTR_UPDATE
	bool "Firmware updates over the network"
	default y
	depends on BOOTLOADER_MCUBOOT && HWTR_ADMIN && FLASH_MAP && SETTINGS
	depends on $(dt_nodelabel_enabled,slot1_partition)
	select HWTR_IMG
	select STREAM_FLASH
	select IMG_MANAGER # its choice defaults to MCUboot
	select IMG_ERASE_PROGRESSIVELY
	select REBOOT
	imply WATCHDOG
	help
	  On when the application is built with MCUboot (sysbuild): an admin
	  request opens an update, the signed image streams into slot 1, the
	  device test-boots it, and the new firmware confirms itself once
	  what worked before the update works again (Wi-Fi, rack bus);
	  otherwise MCUboot puts the previous one back.  The HTTP endpoints
	  are firmware/common/web/update_http.c (hwtr_web_update()).

if HWTR_UPDATE

config HWTR_UPDATE_ID
	string "Image id: <application>/<board>"
	help
	  What the image id TLV of an update must say.  Set, with the
	  imgtool argument that writes it into the signed image, by
	  firmware/common/sysbuild.cmake.

config HWTR_UPDATE_TRIAL_S
	int "Time a new firmware has to confirm itself (s)"
	default 180
	help
	  After a test boot, the new firmware must get back what worked
	  before the update (Wi-Fi, the rack bus) within this time, for 5 s
	  in a row; otherwise it reboots unconfirmed and MCUboot puts the
	  previous firmware back.  The watchdog (watchdog0, 30 s) runs during
	  the trial, for a firmware that hangs.

config HWTR_UPDATE_TEST_KEY
	bool "Signed with MCUboot's public test key"
	help
	  Set by firmware/common/sysbuild.cmake when no signing key was
	  given (HWTR_SIGNING_KEY): anyone can sign an image this device's
	  MCUboot accepts.  The page says so.

endif # HWTR_UPDATE

module = HWTR_RACK
module-str = rack bus
source "subsys/logging/Kconfig.template.log_config"

endmenu
