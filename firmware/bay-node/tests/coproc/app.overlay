/*
 * The coproc partition on the simulated flash, past its default partitions;
 * writes in 4-byte blocks as the ESP32-S3's flash
 *
 * SPDX-License-Identifier: Apache-2.0
 */

&flash0 {
	write-block-size = <4>;

	partitions {
		coproc_partition: partition@100000 {
			compatible = "zephyr,mapped-partition";
			label = "coproc";
			reg = <0x00100000 DT_SIZE_K(256)>;
		};
	};
};
