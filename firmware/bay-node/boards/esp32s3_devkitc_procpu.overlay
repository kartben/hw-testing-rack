/*
 * ESP32-S3-DevKitC-1 v1.1 (WROOM-1-N8R8, the bay node's module) as a
 * stand-in for the bay node: the node's pin map is chosen to be the
 * devkit's, so this only brings in the node's devicetree.  Plug the DUT into
 * the devkit's "USB" port (IO19/IO20) through an OTG adapter and power it
 * separately (that port does not source VBUS); an INA226 breakout goes on
 * IO2 (SDA) / IO1 (SCL) if you have one, otherwise the V/I readings report
 * -ENODEV; the status LED is the devkit's RGB LED (IO38).  The camera (J6)
 * on jumper wires to an Arducam Mega: IO11 SCK, IO10 MOSI, IO9 MISO, IO8 CS,
 * IO7 the light.
 *
 * On a v1.0 devkit the RGB LED is on IO48, AUX_BOOT_CTL here: it flickers
 * with `bay boot`, harmless.
 *
 * SPDX-License-Identifier: Apache-2.0
 */

#include "../../boards/hwtr/bay_node/bay_node-pinctrl.dtsi"
#include "../../boards/hwtr/bay_node/bay_node.dtsi"

/* The 8 MB octal PSRAM (boards/esp32s3_devkitc_procpu.conf) */
&psram0 {
	size = <DT_SIZE_M(8)>;
};
