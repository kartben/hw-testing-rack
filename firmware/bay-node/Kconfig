mainmenu "hw-testing-rack bay node"

menu "Bay node"

config BAY_DUT_FAULT_OFF_MS
	int "Switch the DUT off after this long in current limit (ms)"
	default 1000
	help
	  The TPS2553 limits the current by itself and keeps retrying.  If its
	  FAULT flag stays asserted this long, the firmware switches VBUS off
	  and latches the fault until the next "bay power on".  0 disables.

config BAY_POWER_CYCLE_MS
	int "Default off time of a DUT power cycle (ms)"
	default 1000

config BAY_RESET_PULSE_MS
	int "Default AUX RESET pulse length (ms)"
	default 100

config BAY_BOOTLOADER_HOLD_MS
	int "How long BOOT stays asserted after the RESET pulse (ms)"
	default 200

config BAY_PORTS_BUDGET_MA
	int "DATA x4: the four ports' draw may not pass this (mA)"
	default 1250
	help
	  The node's TPS2553 feeds the four ports through DUT_5V and limits at
	  1.34-1.52 A.  A port goes on only if the others' draw plus
	  BAY_PORTS_RESERVE_MA stays within this (docs/multi-dut-node.md,
	  Power budget).

config BAY_PORTS_RESERVE_MA
	int "DATA x4: kept for a port's start (mA)"
	default 250

config BAY_PORTS_STAGGER_MS
	int "DATA x4: between two ports switched on one after the other (ms)"
	default 300

config BAY_PORTS_SETTLE_MS
	int "DATA x4: after DUT_5V on, before the board's chips are set up (ms)"
	default 5

config BAY_PORTS_POLL_MS
	int "DATA x4: how often the ports' ~FAULT lines are read (ms)"
	default 100

config BAY_PORTS_ON_AT_BOOT
	bool "DATA x4: every port on at boot and after each DUT_5V on"
	default y
	help
	  Off: the ports stay off until switched on.  A port switched off by
	  hand stays off either way.

config BAY_AUX_TCP_PORT
	int "TCP port of the AUX UART as raw bytes (one client), 0 to disable"
	default 4000
	range 0 65535

config BAY_RFC2217_PORT
	int "TCP port of the AUX UART as RFC 2217 (one client), 0 to disable"
	default 4001
	range 0 65535
	help
	  Telnet Com Port Control: pyserial's rfc2217://, labgrid's
	  NetworkSerialPort and esptool set the baud rate and format while
	  they are connected.

config BAY_CONSOLE_WEB_CLIENTS
	int "Web consoles connected at the same time"
	default 2
	range 1 4
	help
	  One WebSocket resource (/console/ws/<n>), a 256-byte buffer and a
	  WebSocket context each.

config BAY_AUX_LOG_SIZE
	int "AUX UART receive log replayed to new web consoles (bytes, power of 2)"
	default 16384

config BAY_AUX_TX_BUF_SIZE
	int "AUX UART transmit buffer (bytes)"
	default 1024

config BAY_HTTP_PORT
	int "TCP port of the web page, JSON API and /metrics"
	default 80
	range 1 65535

config BAY_SERVICE_PHY_HANDOVER
	bool "Give the USB PHY back to USB-Serial-JTAG in SERVICE mode"
	default y
	depends on USBIP
	help
	  The ESP32-S3 has a single full-speed PHY.  The USB host takes it
	  at boot; with this option the firmware stops the host controller
	  when the SERVICE switch is on and routes the PHY to the
	  USB-Serial-JTAG, so a laptop on the front port can flash
	  (esptool auto-reset) and debug (OpenOCD) the node.  Switching
	  SERVICE off starts the host again.

config BAY_ACCESS_CLAIM_S
	int "Seconds to confirm an access claim with BOOT"
	default 60
	range 10 600
	help
	  A claim (the first admin key) waits this long for a short press on
	  BOOT, or "bay access claim" on the local shell.

config BAY_ACCESS_KICK_S
	int "Seconds an address stays refused after a kick"
	default 60

config BAY_ACCESS_RESET_HOLD_MS
	int "Holding BOOT this long resets access control (ms)"
	default 10000
	help
	  Releasing BOOT after this long forgets the admin key, the rules
	  and the lease instead of power-cycling the DUT.

config BAY_CAMERA
	bool "Bay camera (Arducam Mega on J6) and its light"
	default y
	depends on DT_HAS_ARDUCAM_MEGA_ENABLED
	depends on SHARED_MULTI_HEAP
	select VIDEO
	select HWTR_JPEG
	select LED if $(dt_nodelabel_enabled,camera_light)
	select PWM if $(dt_nodelabel_enabled,camera_light)
	help
	  Snapshots and an MJPEG stream on their own port, the light switched
	  with them.  The frames go to PSRAM (the shared multi-heap's
	  external region).  Without a camera on the connector the node runs
	  as before and the API says so.

if BAY_CAMERA

config BAY_CAMERA_PORT
	int "TCP port of the camera (/snapshot.jpg, /stream.mjpg)"
	default 8081
	range 1 65535

config BAY_CAMERA_CLIENTS
	int "Camera clients at the same time (streams and snapshots)"
	default 3
	range 1 8

config BAY_CAMERA_FRAME_KB
	int "Frame buffer size (KB, two of them in PSRAM)"
	default 512
	help
	  A frame larger than this comes over in pieces (it still works).
	  A 640x480 JPEG is 30-60 KB, 1920x1080 at high quality a few
	  hundred.

config BAY_CAMERA_FPS
	int "Stream frame rate cap (frames a second)"
	default 5
	range 1 30

config BAY_CAMERA_LIGHT_SETTLE_MS
	int "Wait after switching the light on, for the auto exposure (ms)"
	default 300

config BAY_CAMERA_STACK_SIZE
	int "Camera thread stack size"
	default 3072

endif # BAY_CAMERA

config BAY_LED_BRIGHTNESS
	int "Status LED brightness (1-255)"
	default 40
	range 1 255

module = BAY
module-str = bay node
source "subsys/logging/Kconfig.template.log_config"

endmenu

# The camera's frame buffers come from the PSRAM region of the shared
# multi-heap (esp_psram.c registers it as external), not from a heap in DRAM
config VIDEO_BUFFER_SMH_ATTRIBUTE
	default 2 if BAY_CAMERA

# That region is the PSRAM heap: two frame buffers and their headers need
# more than its 1 MB default (the N8R8 has 8 MB)
config ESP_SPIRAM_HEAP_SIZE
	default 1572864 if BAY_CAMERA

# Several DUTs over USB/IP, one session each: a DATA x4's 4 ports, the logic
# variant's co-processor on hub port 5 and a spare.  A session is a thread
# (2 KB stack) and a socket; the hub, the DUTs and their descriptors need the
# hub spike's UHC sizing.  The internal RAM for it comes from the Wi-Fi
# adapter's heap, moved to PSRAM (25 KB of the system heap instead of 51; the
# radio's static RX buffers stay internal).  The USB/IP pool and the UHC
# buffers stay in internal RAM: the DWC2 moves them by DMA, which does not
# reach PSRAM.  A board without PSRAM keeps one session.
choice ESP_WIFI_HEAP
	default ESP_WIFI_HEAP_SPIRAM if ESP_SPIRAM
endchoice

config USBIP_DEVICES_COUNT
	default 6 if ESP_SPIRAM

config UHC_XFER_COUNT
	default 32 if ESP_SPIRAM

config UHC_BUF_COUNT
	default 32 if ESP_SPIRAM

config UHC_BUF_POOL_SIZE
	default 4096 if ESP_SPIRAM

config USBH_USB_DEVICE_HEAP
	default 4096 if ESP_SPIRAM

# usbip listener + its sessions (6, and a `usbip list` meanwhile; 1 and a
# list without PSRAM), AUX raw and RFC 2217 listeners + clients, telnet
# listener + client, HTTP listener + 6 clients, 2 web consoles, DHCP, mDNS,
# spare (a web console is a socket plus a websocket descriptor); the camera's
# listener and 3 clients (a camera means PSRAM)
config NET_MAX_CONTEXTS
	default 34 if BAY_CAMERA
	default 30 if ESP_SPIRAM
	default 25

config NET_MAX_CONN
	default 34 if BAY_CAMERA
	default 30 if ESP_SPIRAM
	default 25

config ZVFS_OPEN_MAX
	default 44 if BAY_CAMERA
	default 40 if ESP_SPIRAM
	default 35

# 48 KB of the 64 KB default: the RAM margin for the firmware updates (image
# writer, upload handler).  To be watched on hardware with a busy DUT.  A
# default rather than a prj.conf line: the bench boards without a USB host
# (m5stack_stamps3) have no pool at all.
config USBIP_BUF_POOL_SIZE
	depends on USBIP
	default 49152

# The USB host thread runs each transfer's completion, and USB/IP sends its
# RET_SUBMIT through the network stack from there.  The 1 KB default was full
# (1024 of 1024 bytes) on the bench XIAO with an FT232 streaming over USB/IP,
# and the ESP32-S3 has no stack guard: an overflow corrupts whatever lies next.
config USBH_STACK_SIZE
	depends on USB_HOST_STACK
	default 2048

# The USB/IP threads (the service, one per session) peaked at 1104 bytes with
# an FT232 streaming and a card reader attached: 1.5 KB each instead of 2 pays
# for the host thread's extra 1 KB and saves 2.5 KB more.
config USBIP_THREAD_STACK_SIZE
	depends on USBIP
	default 1536

source "Kconfig.zephyr"
