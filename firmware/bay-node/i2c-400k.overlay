/*
 * The node's I2C bus at 400 kHz instead of 100 kHz.  The bus is the node's
 * INA226 and, over the DATA lead (J7), the drawer's DATA board behind its
 * isolation FETs.  To try at bring-up, with a scope on SDA/SCL at the DATA
 * board: the rise time must stay under 300 ns.
 *
 *   west build -b bay_node/esp32s3/procpu bay-node -- -DEXTRA_DTC_OVERLAY_FILE=i2c-400k.overlay
 *
 * SPDX-License-Identifier: Apache-2.0
 */

#include <zephyr/dt-bindings/i2c/i2c.h>

&i2c0 {
	clock-frequency = <I2C_BITRATE_FAST>;
};
