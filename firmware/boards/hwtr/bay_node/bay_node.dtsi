/*
 * Bay node peripherals, shared by the board definition and by the
 * esp32s3_devkitc stand-in overlay (firmware/bay-node/boards/).
 *
 * Source of truth: electronics/bay-node/design.py.  Keep the pin table in
 * firmware/README.md in sync with this file.
 *
 * SPDX-License-Identifier: Apache-2.0
 */

#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/led/led.h>
#include <zephyr/dt-bindings/pwm/pwm.h>

/ {
	aliases {
		led-strip = &status_led;
	};

	/*
	 * The camera's light: a few white 5 V LEDs on the pod, switched low-side
	 * on LED_K.  25 kHz: slow PWM bands a rolling shutter.
	 */
	camera_light: camera-light {
		compatible = "pwm-leds";

		camera_light_led: light {
			label = "camera light";
			pwms = <&ledc0 0 PWM_KHZ(25) PWM_POLARITY_NORMAL>;
		};
	};

	dut_port: dut-port {
		compatible = "hwtr,dut-port";
		/* IO41 DUT_EN -> TPS2553 EN (100k pull-up: on by default) */
		enable-gpios = <&gpio1 9 GPIO_ACTIVE_HIGH>;
		/* IO40 DUT_FLT_N <- TPS2553 ~FAULT (10k pull-up) */
		fault-gpios = <&gpio1 8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		/* IO12 AUX_RST_CTL / IO48 AUX_BOOT_CTL -> 2N7002 gates (100k pull-downs) */
		reset-gpios = <&gpio0 12 GPIO_ACTIVE_HIGH>;
		boot-gpios = <&gpio1 16 GPIO_ACTIVE_HIGH>;
		power-monitor = <&ina226>;
		uart = <&uart1>;
		/* IO47 AUX_TX as a GPIO: released while the DUT is off, low for a BREAK */
		tx-gpios = <&gpio1 15 GPIO_ACTIVE_HIGH>;
	};

	/*
	 * A DATA x4 board in the drawer (docs/multi-dut-node.md): four ports,
	 * sub-slots <bay>.1-4, on the expanders and INA226s below.  The firmware
	 * probes the board (none: today's one DUT) and drives these chips itself
	 * (src/ports.c): they lose their registers with DUT_5V.  Hub port n is
	 * USB-C n.  Pins: electronics/data-port-x4/design.py.
	 */
	dut_port1: dut-port-1 {
		compatible = "hwtr,dut-port";
		sub-slot = <1>;
		hub-port = <1>;
		/* U2, its left port: P0 RESET, P1 BOOT, P2 EN, P3 FAULT_N */
		enable-gpios = <&ports_io0 2 GPIO_ACTIVE_HIGH>;
		fault-gpios = <&ports_io0 3 GPIO_ACTIVE_LOW>;
		reset-gpios = <&ports_io0 0 GPIO_ACTIVE_LOW>;
		boot-gpios = <&ports_io0 1 GPIO_ACTIVE_LOW>;
		power-monitor = <&port1_sense>;
	};

	dut_port2: dut-port-2 {
		compatible = "hwtr,dut-port";
		sub-slot = <2>;
		hub-port = <2>;
		/* U2, its right port: P4 EN, P5 FAULT_N, P6 BOOT, P7 RESET */
		enable-gpios = <&ports_io0 4 GPIO_ACTIVE_HIGH>;
		fault-gpios = <&ports_io0 5 GPIO_ACTIVE_LOW>;
		reset-gpios = <&ports_io0 7 GPIO_ACTIVE_LOW>;
		boot-gpios = <&ports_io0 6 GPIO_ACTIVE_LOW>;
		power-monitor = <&port2_sense>;
	};

	dut_port3: dut-port-3 {
		compatible = "hwtr,dut-port";
		sub-slot = <3>;
		hub-port = <3>;
		/* U6, as U2 */
		enable-gpios = <&ports_io1 2 GPIO_ACTIVE_HIGH>;
		fault-gpios = <&ports_io1 3 GPIO_ACTIVE_LOW>;
		reset-gpios = <&ports_io1 0 GPIO_ACTIVE_LOW>;
		boot-gpios = <&ports_io1 1 GPIO_ACTIVE_LOW>;
		power-monitor = <&port3_sense>;
	};

	dut_port4: dut-port-4 {
		compatible = "hwtr,dut-port";
		sub-slot = <4>;
		hub-port = <4>;
		enable-gpios = <&ports_io1 4 GPIO_ACTIVE_HIGH>;
		fault-gpios = <&ports_io1 5 GPIO_ACTIVE_LOW>;
		reset-gpios = <&ports_io1 7 GPIO_ACTIVE_LOW>;
		boot-gpios = <&ports_io1 6 GPIO_ACTIVE_LOW>;
		power-monitor = <&port4_sense>;
	};

	usb_mux: usb-mux {
		compatible = "hwtr,usb-mux";
		/* IO14 MUX_FORCE_PC -> OR gate (100k pull-down) */
		force-pc-gpios = <&gpio0 14 GPIO_ACTIVE_HIGH>;
		/* IO13 PC_DET <- front port VBUS, 10k/20k divider */
		pc-detect-gpios = <&gpio0 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
		/* IO15 SVC <- SERVICE slide switch */
		service-gpios = <&gpio0 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
	};

	/* Rack bus (docs/can.md): CAN on the row cable, and the POS addressing token */
	rack_bus: rack-bus {
		compatible = "hwtr,rack-bus";
		/* IO16 POS_IN <- J1.6 through 10k and a BAT54S clamp, 100k pull-down */
		pos-in-gpios = <&gpio0 16 GPIO_ACTIVE_HIGH>;
		/* IO42 POS_OUT -> J2.1 (J2 is J1 mirrored) through 10k and a BAT54S clamp: low until the node has an address */
		pos-out-gpios = <&gpio1 10 GPIO_ACTIVE_HIGH>;
		can = <&twai>;
	};

	status_led: ws2812 {
		compatible = "worldsemi,ws2812-pulse-io";
		pulse-ios = <&rmt 0>;
		chain-length = <1>;
		color-mapping = <LED_COLOR_ID_GREEN
				 LED_COLOR_ID_RED
				 LED_COLOR_ID_BLUE>;
		reset-delay = <300>;
	};
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&uart1 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&bay_aux_uart_default>;
	pinctrl-names = "default";
};

/*
 * 100 kHz: the bus goes out on the DATA lead (J7, 45 cm) to the DATA board,
 * through its isolation FETs; 400 kHz is out of reach on rise time there.
 * firmware/bay-node/i2c-400k.overlay tries 400 kHz at bring-up.
 */
&i2c0 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	pinctrl-0 = <&bay_i2c0_default>;
	pinctrl-names = "default";

	/* U10, A0 = A1 = GND; 50 mOhm shunt R19 -> 81.92 mV / 50 mOhm = 1.64 A full scale */
	ina226: ina226@40 {
		compatible = "ti,ina226";
		reg = <0x40>;
		current-lsb-microamps = <50>;
		rshunt-micro-ohms = <50000>;
		avg-count = <16>;
		/* IO39 INA_ALERT_N (10k pull-up), not used by the driver yet */
		alert-gpios = <&gpio1 7 GPIO_ACTIVE_LOW>;
	};

	/*
	 * The DATA x4's chips, through the DATA lead and the board's isolation
	 * FETs, powered from DUT_5V: src/ports.c drives them, never the drivers
	 * (zephyr,deferred-init, and nothing initializes them).
	 */
	ports_io0: gpio@20 {
		compatible = "ti,tca9538";
		reg = <0x20>;
		gpio-controller;
		#gpio-cells = <2>;
		ngpios = <8>;
		zephyr,deferred-init;
	};

	ports_io1: gpio@21 {
		compatible = "ti,tca9538";
		reg = <0x21>;
		gpio-controller;
		#gpio-cells = <2>;
		ngpios = <8>;
		zephyr,deferred-init;
	};

	/* 100 mOhm shunts: 81.92 mV full scale = 0.82 A, over the 0.50-0.62 A limits */
	port1_sense: ina226@41 {
		compatible = "ti,ina226";
		reg = <0x41>;
		current-lsb-microamps = <25>;
		rshunt-micro-ohms = <100000>;
		zephyr,deferred-init;
	};

	port2_sense: ina226@43 {
		compatible = "ti,ina226";
		reg = <0x43>;
		current-lsb-microamps = <25>;
		rshunt-micro-ohms = <100000>;
		zephyr,deferred-init;
	};

	port3_sense: ina226@44 {
		compatible = "ti,ina226";
		reg = <0x44>;
		current-lsb-microamps = <25>;
		rshunt-micro-ohms = <100000>;
		zephyr,deferred-init;
	};

	port4_sense: ina226@45 {
		compatible = "ti,ina226";
		reg = <0x45>;
		current-lsb-microamps = <25>;
		rshunt-micro-ohms = <100000>;
		zephyr,deferred-init;
	};
};

/* IO18/IO17: TWAI on the TJA1462AT (U11, VIO 3.3 V, STB tied low on the board) */
&twai {
	status = "okay";
	pinctrl-0 = <&bay_twai_default>;
	pinctrl-names = "default";
	bitrate = <250000>;
};

&rmt {
	status = "okay";
	pinctrl-0 = <&bay_led_default>;
	pinctrl-names = "default";
};

/* IO19/IO20: the internal full-speed PHY, wired to MUX_DUT (DUT) and MUX_PC (SERVICE) */
zephyr_uhc0: &usb_otg {
	status = "okay";
};

&wifi {
	status = "okay";
};

&ledc0 {
	pinctrl-0 = <&bay_ledc0_default>;
	pinctrl-names = "default";
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	channel0@0 {
		reg = <0x0>;
		timer = <0>;
	};
};

/*
 * J6: the bay camera, an Arducam Mega on a ~50 cm lead: SPI mode 0 at 4 MHz
 * (2 MHz if the lead misbehaves).  No DMA: the CPU copies into the frame
 * buffer in PSRAM.  Optional: without a camera its driver fails to start
 * and the node runs on, the API says "no camera".
 */
&spi2 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";
	pinctrl-0 = <&bay_spim2_default>;
	pinctrl-names = "default";
	cs-gpios = <&gpio0 8 GPIO_ACTIVE_LOW>;

	camera: camera@0 {
		compatible = "arducam,mega";
		reg = <0>;
		spi-max-frequency = <4000000>;
	};
};
