/*
 * Bay node peripherals, shared by the board definition and by the
 * esp32s3_devkitc stand-in overlay (firmware/bay-node/boards/).
 *
 * Source of truth: electronics/bay-node/design.py.  Keep the pin table in
 * firmware/README.md in sync with this file.
 *
 * SPDX-License-Identifier: Apache-2.0
 */

#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/led/led.h>

/ {
	aliases {
		led-strip = &status_led;
	};

	dut_port: dut-port {
		compatible = "hwtr,dut-port";
		/* IO41 DUT_EN -> TPS2553 EN (100k pull-up: on by default) */
		enable-gpios = <&gpio1 9 GPIO_ACTIVE_HIGH>;
		/* IO40 DUT_FLT_N <- TPS2553 ~FAULT (10k pull-up) */
		fault-gpios = <&gpio1 8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		/* IO34 AUX_RST_CTL / IO48 AUX_BOOT_CTL -> 2N7002 gates (100k pull-downs) */
		reset-gpios = <&gpio1 2 GPIO_ACTIVE_HIGH>;
		boot-gpios = <&gpio1 16 GPIO_ACTIVE_HIGH>;
		power-monitor = <&ina226>;
		uart = <&uart1>;
		/* IO47 AUX_TX as a GPIO: released while the DUT is off, low for a BREAK */
		tx-gpios = <&gpio1 15 GPIO_ACTIVE_HIGH>;
	};

	usb_mux: usb-mux {
		compatible = "hwtr,usb-mux";
		/* IO14 MUX_FORCE_PC -> OR gate (100k pull-down) */
		force-pc-gpios = <&gpio0 14 GPIO_ACTIVE_HIGH>;
		/* IO13 PC_DET <- front port VBUS, 10k/20k divider */
		pc-detect-gpios = <&gpio0 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
		/* IO15 SVC <- SERVICE slide switch */
		service-gpios = <&gpio0 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
	};

	/* Rack bus (docs/can.md): CAN on the row cable, and the POS addressing token */
	rack_bus: rack-bus {
		compatible = "hwtr,rack-bus";
		/* IO16 POS_IN <- J1.6 through 10k and a BAT54S clamp, 100k pull-down */
		pos-in-gpios = <&gpio0 16 GPIO_ACTIVE_HIGH>;
		/* IO35 POS_OUT -> J2.6 through 10k and a BAT54S clamp: low until the node has an address */
		pos-out-gpios = <&gpio1 3 GPIO_ACTIVE_HIGH>;
		can = <&twai>;
	};

	status_led: ws2812 {
		compatible = "worldsemi,ws2812-pulse-io";
		pulse-ios = <&rmt 0>;
		chain-length = <1>;
		color-mapping = <LED_COLOR_ID_GREEN
				 LED_COLOR_ID_RED
				 LED_COLOR_ID_BLUE>;
		reset-delay = <300>;
	};
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&uart1 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&bay_aux_uart_default>;
	pinctrl-names = "default";
};

&i2c0 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;
	pinctrl-0 = <&bay_i2c0_default>;
	pinctrl-names = "default";

	/* U10, A0 = A1 = GND; 50 mOhm shunt R19 -> 81.92 mV / 50 mOhm = 1.64 A full scale */
	ina226: ina226@40 {
		compatible = "ti,ina226";
		reg = <0x40>;
		current-lsb-microamps = <50>;
		rshunt-micro-ohms = <50000>;
		avg-count = <16>;
		/* IO39 INA_ALERT_N (10k pull-up), not used by the driver yet */
		alert-gpios = <&gpio1 7 GPIO_ACTIVE_LOW>;
	};
};

/* IO18/IO17: TWAI on the TCAN1044AV (U11, VIO 3.3 V, STB tied low on the board) */
&twai {
	status = "okay";
	pinctrl-0 = <&bay_twai_default>;
	pinctrl-names = "default";
	bitrate = <250000>;
};

&rmt {
	status = "okay";
	pinctrl-0 = <&bay_led_default>;
	pinctrl-names = "default";
};

/* IO19/IO20: the internal full-speed PHY, wired to MUX_DUT (DUT) and MUX_PC (SERVICE) */
zephyr_uhc0: &usb_otg {
	status = "okay";
};

&wifi {
	status = "okay";
};
