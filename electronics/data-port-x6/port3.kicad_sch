	)
	(text_box "Port 3 = hub port 2, busid 1-1.2; supplied by +5V_A.\nINA226 at 0x44; EN and FAULT_N on the TCA9535 U2 (0x20).\nILIM 47k: 0.50–0.62 A; the -1 latches off after 7.5 ms in limit, FAULT_N flags it.\nINA226 Vbus on the shunt's load-side sense pad (= VBUS).\nEN pulled down: the port stays off until the node switches it on.\nSource only (Rp from the switched VBUS); a back-feeding source trips the TPS2553 (latched)."
		(exclude_from_sim no)
		(at 274.32 127 0)
		(size 127 17.78)
		(margins 1.5 1.5 1.5 1.5)
		(stroke
			(width 0)
			(type dash)
		)
