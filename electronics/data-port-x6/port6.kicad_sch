	(text_box "Port 6 = hub port 5, busid 1-1.5; supplied by +5V_B.\nINA226 at 0x4c; EN and FAULT_N on the TCA9535 U2 (0x20).\nILIM 45.3k: 524 / 577 / 638 mA min / typ / max (TI SLVS841G §8.5.1 eq. 1–3), 519–644 mA with the\n  resistor's 1 %; the -1 latches off after 7.5 ms in limit, FAULT_N flags it.\nINA226 Vbus on the shunt's load-side sense pad (= VBUS).\nEN pulled down: the port stays off until the node switches it on.\nSource only (Rp from the switched VBUS); a back-feeding source trips the TPS2553 (latched)."
		(exclude_from_sim no)
		(at 274.32 127 0)
		(size 127 20.32)
		(margins 1.5 1.5 1.5 1.5)
		(stroke
			(width 0)
			(type dash)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "0ee2a965-8e9f-5a9e-840c-c21d4f3369f4")
	)
