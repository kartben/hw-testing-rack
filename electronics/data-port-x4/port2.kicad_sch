	)
	(text_box "Port 2 = sub-slot A1.2 (the bay's position,\n  then the port), hub port 2, busid 1-1.2.\nINA226 at 0x43; expander U2 (0x20):\n  P4 EN, P5 FLT_N, P6 BOOT, P7 RST.\nILIM 47k: 0.50–0.62 A (TI's IOS equations).\n  The -1 limits for 7.5 ms, then latches off\n  until EN toggles; FAULT_N flags it.\nEN pulled up: the port is on with no firmware.\nRESET/BOOT: output register 0; the pin as an\n  output pulls low, as an input it floats.\nPigtail: 1 GND, 2 RESET_N, 3 BOOT_N (Dupont\n  female jumpers to the board's own pins)."
		(exclude_from_sim no)
		(at 284.48 157.48 0)
		(size 127 31.75)
		(margins 1.5 1.5 1.5 1.5)
		(stroke
			(width 0)
			(type dash)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "d555ec95-c027-5632-a63d-f87a8e7c05ee")
	)
