(version 1)
# Thermal reliefs on the pours (pcbgen.py), against tombstoning: small parts with one end on a pour.
# On fine-pitch pads (ESP32 module, MSOP/SOT pins) the neighbours leave room for one spoke only: one
# spoke is still a relief, enough for a signal or decoupling pad.  Pads that carry a board's power
# connect solid (b.pcb["power_nets"], power_pads()), and the power nets' rules below ask for more.
(rule "one thermal spoke is enough"
	(constraint min_resolved_spokes 1))

(rule "parts overhanging the outline"
	(layer "F.SilkS")
	(condition "(A.memberOfFootprint('J*')) && B.Layer == 'Edge.Cuts'")
	(constraint silk_clearance (min -10mm)))

(rule "USB4105 J101: GND pads beside its own pegs"
	(condition "A.memberOfFootprint('J101') && B.memberOfFootprint('J101')")
	(constraint hole_clearance (min 0.19mm)))

(rule "USB4105 J201: GND pads beside its own pegs"
	(condition "A.memberOfFootprint('J201') && B.memberOfFootprint('J201')")
	(constraint hole_clearance (min 0.19mm)))

(rule "USB4105 J301: GND pads beside its own pegs"
	(condition "A.memberOfFootprint('J301') && B.memberOfFootprint('J301')")
	(constraint hole_clearance (min 0.19mm)))

(rule "USB4105 J401: GND pads beside its own pegs"
	(condition "A.memberOfFootprint('J401') && B.memberOfFootprint('J401')")
	(constraint hole_clearance (min 0.19mm)))

(rule "power pins connect solid"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'SMD' && (A.NetName == '+5V' || A.NetName == '/Port 1/PORT1_5V_SW' || A.NetName == '/Port 1/PORT1_VBUS' || A.NetName == '/Port 2/PORT2_5V_SW' || A.NetName == '/Port 2/PORT2_VBUS' || A.NetName == '/Port 3/PORT3_5V_SW' || A.NetName == '/Port 3/PORT3_VBUS' || A.NetName == '/Port 4/PORT4_5V_SW' || A.NetName == '/Port 4/PORT4_VBUS' || A.NetName == 'GND') && (A.memberOfFootprint('U*') || A.memberOfFootprint('J*') || A.memberOfFootprint('L*'))")
	(constraint zone_connection solid))

(rule "power nets: 2 spokes where relieved"
	(condition "A.Type == 'Pad' && (A.NetName == '+5V' || A.NetName == '/Port 1/PORT1_5V_SW' || A.NetName == '/Port 1/PORT1_VBUS' || A.NetName == '/Port 2/PORT2_5V_SW' || A.NetName == '/Port 2/PORT2_VBUS' || A.NetName == '/Port 3/PORT3_5V_SW' || A.NetName == '/Port 3/PORT3_VBUS' || A.NetName == '/Port 4/PORT4_5V_SW' || A.NetName == '/Port 4/PORT4_VBUS')")
	(constraint min_resolved_spokes 2))
