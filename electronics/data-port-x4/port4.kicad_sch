		(uuid "a1e992a4-7b37-514a-92c2-f2a96588b9cc")
	)
	(text_box "Port 4 = sub-slot A1.4 (the bay's position,\n  then the port), hub port 4, busid 1-1.4.\nINA226 at 0x45; expander U6 (0x21):\n  P4 EN, P5 FLT_N, P6 BOOT, P7 RST.\nILIM 47k: 0.50–0.62 A (TI's IOS equations).\n  The -1 limits for 7.5 ms, then latches off\n  until EN toggles; FAULT_N flags it.\nEN pulled down: the port is off until the\n  firmware enables it within the bay's budget.\nRESET/BOOT: output register 0; the pin as an\n  output pulls low, as an input the 100k holds it high.\nPigtail: 1 GND, 2 RESET_N, 3 BOOT_N (Dupont\n  female jumpers to the board's own pins)."
		(exclude_from_sim no)
		(at 284.48 157.48 0)
		(size 127 33.02)
		(margins 1.5 1.5 1.5 1.5)
		(stroke
			(width 0)
			(type dash)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "9df12ead-1b52-56cb-95be-26e24651ebb8")
	)
