	(text "The node's matrix expander (TCA9534A, 0x38): the crosspoints and the co-processor's RUN / BOOTSEL"
		(exclude_from_sim no)
		(at 290.83 149.86 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "70c77e4c-0edb-572d-8487-74c540230461")
	)
	(text_box "CH446Q serial mode (P/S low): 7 address bits on CK, data on DAT, latched by STB; RST high = all open.\nTCA9534A 0x38: P0 DAT, P1 CK, P2 STB U7, P3 STB U8, P4 RST, P5 RUN, P6 BOOTSEL, P7 mark.\nRUN and BOOTSEL are open drain emulated (output register 0, the pin switched to output).\n±5 V on purpose: at a single 5 V R_on is 120–225 Ω, and a 1.8 V board's I²C low would fail."
		(exclude_from_sim no)
		(at 289.56 294.64 0)
		(size 279.4 13.97)
		(margins 1.5 1.5 1.5 1.5)
		(stroke
			(width 0)
			(type dash)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "6f3e7548-27d8-532e-bcd5-d6b85e767d6e")
	)
