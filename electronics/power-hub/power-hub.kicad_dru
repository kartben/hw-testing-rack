(version 1)
# Thermal reliefs on the pours (pcbgen.py), against tombstoning: small parts with one end on a pour.
# On fine-pitch pads (ESP32 module, MSOP/SOT pins) the neighbours leave room for one spoke only: one
# spoke is still a relief, enough for a signal or decoupling pad.  Pads that carry a board's power
# connect solid (b.pcb["power_nets"], power_pads()), and the power nets' rules below ask for more.
(rule "one thermal spoke is enough"
	(constraint min_resolved_spokes 1))

(rule "parts overhanging the outline"
	(layer "F.SilkS")
	(condition "(A.memberOfFootprint('J*') || A.memberOfFootprint('U4') || A.memberOfFootprint('D1*') || A.memberOfFootprint('D2*') || A.memberOfFootprint('D3') || A.memberOfFootprint('D8')) && B.Layer == 'Edge.Cuts'")
	(constraint silk_clearance (min -10mm)))

(rule "USB4105 J1: GND pads beside its own pegs"
	(condition "A.memberOfFootprint('J1') && B.memberOfFootprint('J1')")
	(constraint hole_clearance (min 0.19mm)))

(rule "USB4105 J6: GND pads beside its own pegs"
	(condition "A.memberOfFootprint('J6') && B.memberOfFootprint('J6')")
	(constraint hole_clearance (min 0.19mm)))

(rule "power pins connect solid"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'SMD' && (A.NetName == '+5V' || A.NetName == '/Controller/+5V_BUCK' || A.NetName == '/Controller/USB_VBUS' || A.NetName == '/Outputs/ROW_A' || A.NetName == '/Outputs/ROW_B' || A.NetName == '/Outputs/ROW_C' || A.NetName == '/Outputs/ROW_D' || A.NetName == 'GND' || A.NetName == 'VRACK') && (A.memberOfFootprint('U*') || A.memberOfFootprint('J*') || A.memberOfFootprint('L*'))")
	(constraint zone_connection solid))

(rule "power nets: 2 spokes where relieved"
	(condition "A.Type == 'Pad' && (A.NetName == '+5V' || A.NetName == '/Controller/+5V_BUCK' || A.NetName == '/Controller/USB_VBUS' || A.NetName == '/Outputs/ROW_A' || A.NetName == '/Outputs/ROW_B' || A.NetName == '/Outputs/ROW_C' || A.NetName == '/Outputs/ROW_D' || A.NetName == 'VRACK')")
	(constraint min_resolved_spokes 2))
