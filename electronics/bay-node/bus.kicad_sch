	)
	(text_box "CAN (docs/can.md): one bus for the rack, a star from the hub; both terminations sit in the hub.\n  250 kbit/s (125 kbit/s fallback).  TJA1462AT (SIC): VCC 5 V, VIO 3.3 V, bus pins −36/+40 V, passive unpowered.\nPOS: active-high 3.3 V token.  From reset the node holds POS_OUT low; when POS_IN goes high and it has\n  no address yet, it answers with its MAC, takes (row, position) from the hub, then raises POS_OUT.\n  R29 keeps POS_IN low with no cable; the next node's 150k keeps POS_OUT low before firmware."
		(exclude_from_sim no)
		(at 15.24 177.8 0)
		(size 162.56 16.51)
		(margins 1.5 1.5 1.5 1.5)
		(stroke
			(width 0)
			(type dash)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "7e871313-0c11-5843-9805-0becb551ab3e")
	)
