	(text "Pins 3: ESD in flow-through, 100 Ω, LSF0108 (A = the DUT's VREF, B = 3.3 V) to crosspoint U8's X lines"
		(exclude_from_sim no)
		(at 16.51 266.7 0)
		(effects
			(font
				(size 1.8 1.8)
