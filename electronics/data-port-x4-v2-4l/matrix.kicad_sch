		)
		(uuid "deb5bf6c-c50a-5b48-bbf9-aa6d32094b11")
	)
	(text_box "CH446Q serial mode (P/S low): 7 address bits on CK, data on DAT, latched by STB; RST high = all open.\nTCA9534A 0x38: P0 DAT, P1 CK, P2 STB U7, P3 STB U8, P4 RST, P5 RUN, P6 BOOTSEL, P7 mark.\nRUN and BOOTSEL are open drain emulated (output register 0, the pin switched to output)."
		(exclude_from_sim no)
		(at 289.56 294.64 0)
		(size 279.4 11.43)
		(margins 1.5 1.5 1.5 1.5)
		(stroke
