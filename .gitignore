# Python
.venv/
__pycache__/
*.pyc

# Machine-specific Claude Code MCP config (see CONTRIBUTING.md)
.mcp.json

# KiCad scratch / backups (incl. KiCad 10's per-project local history)
*-backups/
.history/
*.kicad_prl
*.lck
fp-info-cache
_autosave-*
\#auto_saved_files#
electronics/**/build/

# OpenSCAD / mechanical build outputs (STL/3MF are published by CI)
mechanical/build/

# Scratch
.cache/
*.log

# Big or reproducible electronics outputs (CI artifacts carry them)
electronics/*/fab/gerbers/
electronics/*/fab/*.step
electronics/*/fab/*.glb
electronics/*/docs/svg/
electronics/**/__pycache__/
*.kicad_prl
*.lck
~*.lck

# Render scratch (baked scenes are regenerated by tools/render.sh)
render/*.glb

# Local preview server config (machine-specific paths)
.claude/
render/assets/

# Per-installation CI data for tools/bayctl.py (see config/lab.example.yaml)
config/lab.yaml
rack-map.yaml
rack-scripts/

# LCSC / EasyEDA 3D models: fetched on demand by tools/fetch_pcb_models.py (not redistributed)
electronics/lib/3dmodels/easyeda/
