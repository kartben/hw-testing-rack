From fb7ade5b4681be8c753028cea1cc7f97eeda96ef Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Benjamin=20Cab=C3=A9?= <benjamin@zephyrproject.org>
Date: Mon, 26 Oct 2026 13:14:18 +0100
Subject: [PATCH 1/2] net: sockets: open the receive window as recv() consumes
 data
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The receive window of a stream socket is opened again by the amount of
data read only when recv() returns. A blocking recv() with MSG_WAITALL
for more than the receive window then never returns: the peer stops once
the window is full, and the window opens only after all the data is in.

Open the window by the data consumed as recv() goes, so that a recv()
that waits for more lets the peer send it.

Signed-off-by: Benjamin Cabé <benjamin@zephyrproject.org>
Assisted-by: Claude:opus-5.5
---
 subsys/net/lib/sockets/sockets_inet.c | 14 ++++++++++----
 1 file changed, 10 insertions(+), 4 deletions(-)

diff --git a/subsys/net/lib/sockets/sockets_inet.c b/subsys/net/lib/sockets/sockets_inet.c
index 875dd606c42..4853516d301 100644
--- a/subsys/net/lib/sockets/sockets_inet.c
+++ b/subsys/net/lib/sockets/sockets_inet.c
@@ -1595,6 +1595,14 @@ static int zsock_fionwrite_ctx(struct net_context *ctx)
 	return outq_bytes;
 }
 
+/* Open the receive window by the data consumed, while recv() waits for more */
+static void zsock_recv_stream_consumed(struct net_context *ctx, size_t len, int flags)
+{
+	if (len > 0 && !(flags & ZSOCK_MSG_PEEK)) {
+		net_context_update_recv_wnd(ctx, len);
+	}
+}
+
 static ssize_t zsock_recv_stream_timed(struct net_context *ctx, struct net_msghdr *msg,
 				       uint8_t *buf, size_t max_len,
 				       int flags, k_timeout_t timeout)
@@ -1652,6 +1660,7 @@ static ssize_t zsock_recv_stream_timed(struct net_context *ctx, struct net_msghd
 again:
 			res = zsock_recv_stream_immediate(ctx, &buf, &available_len, flags);
 			recv_len += res;
+			zsock_recv_stream_consumed(ctx, res, flags);
 
 			if (res == 0 && recv_len == 0 && K_TIMEOUT_EQ(timeout, K_NO_WAIT)) {
 				return -EAGAIN;
@@ -1682,6 +1691,7 @@ again:
 		} else {
 			res = zsock_recv_stream_immediate(ctx, &buf, &max_len, flags);
 			recv_len += res;
+			zsock_recv_stream_consumed(ctx, res, flags);
 
 			if (res == 0) {
 				if (recv_len == 0 && K_TIMEOUT_EQ(timeout, K_NO_WAIT)) {
@@ -1741,10 +1751,6 @@ static ssize_t zsock_recv_stream(struct net_context *ctx, struct net_msghdr *msg
 		return -1;
 	}
 
-	if (!(flags & ZSOCK_MSG_PEEK)) {
-		net_context_update_recv_wnd(ctx, recv_len);
-	}
-
 	return recv_len;
 }
 
