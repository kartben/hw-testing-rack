From 2ea03f92140950f50d85b075c74371f2ed846f92 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Benjamin=20Cab=C3=A9?= <benjamin@zephyrproject.org>
Date: Wed, 21 Oct 2026 19:02:19 +0200
Subject: [PATCH 1/3] usb: host: hub: debounce the port connection before reset
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The port was reset as soon as a connection change was reported. Wait
for the connection status to be stable for TATTDB (100 ms, USB 2.0
7.1.7.3) first, as a device being plugged in or still powering up
makes and breaks the connection.

Signed-off-by: Benjamin Cabé <benjamin@zephyrproject.org>
Assisted-by: Claude:opus-5.5
---
 subsys/usb/host/class/usbh_hub.c | 62 +++++++++++++++++++++++++++++++-
 1 file changed, 61 insertions(+), 1 deletion(-)

diff --git a/subsys/usb/host/class/usbh_hub.c b/subsys/usb/host/class/usbh_hub.c
index 4ff82887351..ea19d369e9a 100644
--- a/subsys/usb/host/class/usbh_hub.c
+++ b/subsys/usb/host/class/usbh_hub.c
@@ -19,6 +19,11 @@
 
 LOG_MODULE_REGISTER(usbh_hub, CONFIG_USBH_HUB_LOG_LEVEL);
 
+/* Connect debounce, TATTDB is 100 ms (USB 2.0, 7.1.7.3) */
+#define HUB_DEBOUNCE_POLL_MS		25
+#define HUB_DEBOUNCE_STABLE_MS		100
+#define HUB_DEBOUNCE_TIMEOUT_MS		1500
+
 static K_KERNEL_STACK_DEFINE(hub_stack, CONFIG_USBH_HUB_STACK_SIZE);
 static struct k_work_q hub_work_q;
 
@@ -273,11 +278,51 @@ static void hub_port_handle_change(struct usbh_hub_data *const hub_data,
 	}
 
 	LOG_DBG("Device connected to port %d, scheduling reset and enumeration", port_num);
-	port_instance->state = PORT_STATE_DISABLED;
+	port_instance->state = PORT_STATE_DISCONNECTED;
 	port_instance->reset_count = CONFIG_USBH_HUB_PORT_RESET_TIMES;
 	port_instance->enum_pending = true;
 }
 
+/*
+ * Wait until the hub has reported no connection change for TATTDB. Returns 0
+ * if a device is connected, -ENOTCONN if the port is empty.
+ */
+static int hub_port_debounce(struct usbh_hub_data *const hub_data, const uint8_t port_num)
+{
+	const int64_t deadline = k_uptime_get() + HUB_DEBOUNCE_TIMEOUT_MS;
+	int64_t last_change = k_uptime_get();
+	uint16_t port_status;
+	uint16_t port_change;
+	int ret;
+
+	while (k_uptime_get() < deadline) {
+		k_msleep(HUB_DEBOUNCE_POLL_MS);
+
+		ret = usbh_req_get_port_status(hub_data->udev, port_num,
+					       &port_status, &port_change);
+		if (ret != 0) {
+			return ret;
+		}
+
+		if ((port_change & USB_HUB_PORT_CHANGE_CONNECTION) != 0) {
+			ret = usbh_req_clear_hcfs_c_port_connection(hub_data->udev, port_num);
+			if (ret != 0) {
+				return ret;
+			}
+
+			last_change = k_uptime_get();
+		} else if (k_uptime_get() - last_change >= HUB_DEBOUNCE_STABLE_MS) {
+			if ((port_status & USB_HUB_PORT_STATUS_CONNECTION) == 0) {
+				return -ENOTCONN;
+			}
+
+			return 0;
+		}
+	}
+
+	return -ETIMEDOUT;
+}
+
 static void hub_port_process(struct usbh_hub_data *const hub_data,
 			     struct usb_hub_port *const port_instance)
 {
@@ -292,6 +337,21 @@ static void hub_port_process(struct usbh_hub_data *const hub_data,
 
 	while (hub_data->connected) {
 		switch (port_instance->state) {
+		case PORT_STATE_DISCONNECTED:
+			ret = hub_port_debounce(hub_data, port_num);
+			if (ret == -ENOTCONN) {
+				LOG_DBG("Port %d disconnected", port_num);
+				return;
+			}
+
+			if (ret != 0) {
+				LOG_WRN("Port %d connect debounce failed: %d", port_num, ret);
+				return;
+			}
+
+			port_instance->state = PORT_STATE_DISABLED;
+			continue;
+
 		case PORT_STATE_DISABLED:
 			if (port_instance->reset_count == 0) {
 				LOG_ERR("Port %d reset retry count exhausted, giving up",

From 43754f9cbb061b90f4c9c87db494da944bbe04c2 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Benjamin=20Cab=C3=A9?= <benjamin@zephyrproject.org>
Date: Wed, 21 Oct 2026 19:03:25 +0200
Subject: [PATCH 2/3] usb: host: hub: wait for the hub to end the port reset
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The reset was considered complete if the reset change bit was set 20 ms
after the request. A hub may drive the reset for longer, and a reset
change left over from a previous reset is taken for the end of the
current one, after which the port reads as not enabled.

Poll the port status until the hub clears PORT_RESET, and give the
device the reset recovery time TRSTRCY before addressing it (USB 2.0,
7.1.7.5). Log the port status and change bits when the port is not
enabled after reset.

Signed-off-by: Benjamin Cabé <benjamin@zephyrproject.org>
Assisted-by: Claude:opus-5.5
---
 subsys/usb/host/class/usbh_hub.c | 20 ++++++++++++++++++--
 1 file changed, 18 insertions(+), 2 deletions(-)

diff --git a/subsys/usb/host/class/usbh_hub.c b/subsys/usb/host/class/usbh_hub.c
index ea19d369e9a..72897f8ada5 100644
--- a/subsys/usb/host/class/usbh_hub.c
+++ b/subsys/usb/host/class/usbh_hub.c
@@ -24,6 +24,12 @@ LOG_MODULE_REGISTER(usbh_hub, CONFIG_USBH_HUB_LOG_LEVEL);
 #define HUB_DEBOUNCE_STABLE_MS		100
 #define HUB_DEBOUNCE_TIMEOUT_MS		1500
 
+/* The hub ends the port reset, TDRST is 10 to 20 ms (USB 2.0, 7.1.7.5) */
+#define HUB_RESET_POLL_MS		10
+#define HUB_RESET_TIMEOUT_MS		500
+/* Reset recovery time TRSTRCY (USB 2.0, 7.1.7.5) */
+#define HUB_RESET_RECOVERY_MS		10
+
 static K_KERNEL_STACK_DEFINE(hub_stack, CONFIG_USBH_HUB_STACK_SIZE);
 static struct k_work_q hub_work_q;
 
@@ -329,6 +335,7 @@ static void hub_port_process(struct usbh_hub_data *const hub_data,
 	struct usb_hub_port_status port_sts;
 	struct usb_device *udev;
 	const uint8_t port_num = port_instance->num;
+	int64_t reset_start = 0;
 	uint16_t port_status;
 	uint16_t port_change;
 	int ret;
@@ -367,6 +374,7 @@ static void hub_port_process(struct usbh_hub_data *const hub_data,
 
 			port_instance->reset_count--;
 			port_instance->state = PORT_STATE_RESETTING;
+			reset_start = k_uptime_get();
 			/* specification requires 10-20ms, Default is 20ms for worst case. */
 			k_sleep(K_MSEC(CONFIG_USBH_HUB_PORT_RESET_DELAY_MS));
 			continue;
@@ -382,7 +390,12 @@ static void hub_port_process(struct usbh_hub_data *const hub_data,
 			port_sts.wPortStatus = port_status;
 			port_sts.wPortChange = port_change;
 
-			if ((port_sts.wPortChange & USB_HUB_PORT_CHANGE_RESET) == 0) {
+			if ((port_sts.wPortStatus & USB_HUB_PORT_STATUS_RESET) != 0) {
+				if (k_uptime_get() - reset_start < HUB_RESET_TIMEOUT_MS) {
+					k_msleep(HUB_RESET_POLL_MS);
+					continue;
+				}
+
 				if (port_instance->reset_count > 0) {
 					LOG_WRN("Port %d reset timeout, retrying (%d left)",
 						port_num, port_instance->reset_count);
@@ -422,7 +435,8 @@ static void hub_port_process(struct usbh_hub_data *const hub_data,
 			}
 
 			if ((port_sts.wPortStatus & USB_HUB_PORT_STATUS_ENABLE) == 0) {
-				LOG_WRN("Port %d not enabled after reset", port_num);
+				LOG_WRN("Port %d not enabled, status 0x%04x change 0x%04x",
+					port_num, port_sts.wPortStatus, port_sts.wPortChange);
 
 				if (port_instance->reset_count > 0) {
 					LOG_WRN("Port %d retrying reset (%d left)",
@@ -437,6 +451,8 @@ static void hub_port_process(struct usbh_hub_data *const hub_data,
 				return;
 			}
 
+			k_msleep(HUB_RESET_RECOVERY_MS);
+
 			ret = enumerate_port_device(hub_data, port_instance, port_num,
 						    &port_sts);
 			if (ret != 0) {

From 186d0be4632545daab4e05a9cbcb24b6645945d8 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Benjamin=20Cab=C3=A9?= <benjamin@zephyrproject.org>
Date: Wed, 21 Oct 2026 19:04:05 +0200
Subject: [PATCH 3/3] usb: host: hub: reset a port again only on a new
 connection
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Once all resets of a port had failed, any later change on the port,
such as the enable change of a port the hub disabled, restored the
reset count and started the resets over, in a loop without delay.

Start over only on a connection change, as when a device is attached
again. A device attached again during a reset is debounced before the
next reset.

Signed-off-by: Benjamin Cabé <benjamin@zephyrproject.org>
Assisted-by: Claude:opus-5.5
---
 subsys/usb/host/class/usbh_hub.c | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/subsys/usb/host/class/usbh_hub.c b/subsys/usb/host/class/usbh_hub.c
index 72897f8ada5..4a65a89944a 100644
--- a/subsys/usb/host/class/usbh_hub.c
+++ b/subsys/usb/host/class/usbh_hub.c
@@ -191,6 +191,7 @@ static void hub_port_handle_change(struct usbh_hub_data *const hub_data,
 	const uint8_t port_num = port_instance->num;
 	uint16_t port_status;
 	uint16_t port_change;
+	bool connect_change;
 	int ret;
 
 	ret = usbh_req_get_port_status(hub_data->udev, port_num,
@@ -200,6 +201,7 @@ static void hub_port_handle_change(struct usbh_hub_data *const hub_data,
 		return;
 	}
 
+	connect_change = (port_change & USB_HUB_PORT_CHANGE_CONNECTION) != 0;
 	port_sts.wPortStatus = port_status;
 	port_sts.wPortChange = port_change;
 	LOG_DBG("Port %d status: wPortStatus=0x%04x, wPortChange=0x%04x",
@@ -277,6 +279,11 @@ static void hub_port_handle_change(struct usbh_hub_data *const hub_data,
 		return;
 	}
 
+	if (port_instance->udev == NULL && !connect_change) {
+		LOG_DBG("Port %d not reset again without a new connection", port_num);
+		return;
+	}
+
 	if (port_instance->udev != NULL) {
 		udev = port_instance->udev;
 		port_instance->udev = NULL;
@@ -434,6 +441,15 @@ static void hub_port_process(struct usbh_hub_data *const hub_data,
 				return;
 			}
 
+			/* A device attached again is debounced before the next reset */
+			if ((port_sts.wPortChange & USB_HUB_PORT_CHANGE_CONNECTION) != 0 &&
+			    port_instance->reset_count > 0) {
+				LOG_WRN("Port %d connection changed during reset", port_num);
+				port_instance->state = PORT_STATE_DISCONNECTED;
+				k_sleep(K_MSEC(CONFIG_USBH_HUB_ENUM_RETRY_DELAY_MS));
+				continue;
+			}
+
 			if ((port_sts.wPortStatus & USB_HUB_PORT_STATUS_ENABLE) == 0) {
 				LOG_WRN("Port %d not enabled, status 0x%04x change 0x%04x",
 					port_num, port_sts.wPortStatus, port_sts.wPortChange);
