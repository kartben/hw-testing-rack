From 25a41a74428c2be3c116d4ef90cad6b37c25f574 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Benjamin=20Cab=C3=A9?= <benjamin@zephyrproject.org>
Date: Wed, 21 Oct 2026 19:04:05 +0200
Subject: [PATCH 3/3] usb: host: hub: reset a port again only on a new
 connection
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Once all resets of a port had failed, any later change on the port,
such as the enable change of a port the hub disabled, restored the
reset count and started the resets over, in a loop without delay.

Start over only on a connection change, as when a device is attached
again. A device attached again during a reset is debounced before the
next reset.

Signed-off-by: Benjamin Cabé <benjamin@zephyrproject.org>
Assisted-by: Claude:opus-5.5
---
 subsys/usb/host/class/usbh_hub.c | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/subsys/usb/host/class/usbh_hub.c b/subsys/usb/host/class/usbh_hub.c
index 0abbb42d574..479adcf32e3 100644
--- a/subsys/usb/host/class/usbh_hub.c
+++ b/subsys/usb/host/class/usbh_hub.c
@@ -191,6 +191,7 @@ static void hub_port_handle_change(struct usbh_hub_data *const hub_data,
 	const uint8_t port_num = port_instance->num;
 	uint16_t port_status;
 	uint16_t port_change;
+	bool connect_change;
 	int ret;
 
 	ret = usbh_req_get_port_status(hub_data->udev, port_num,
@@ -200,6 +201,7 @@ static void hub_port_handle_change(struct usbh_hub_data *const hub_data,
 		return;
 	}
 
+	connect_change = (port_change & USB_HUB_PORT_CHANGE_CONNECTION) != 0;
 	port_sts.wPortStatus = port_status;
 	port_sts.wPortChange = port_change;
 	LOG_DBG("Port %d status: wPortStatus=0x%04x, wPortChange=0x%04x",
@@ -277,6 +279,11 @@ static void hub_port_handle_change(struct usbh_hub_data *const hub_data,
 		return;
 	}
 
+	if (port_instance->udev == NULL && !connect_change) {
+		LOG_DBG("Port %d not reset again without a new connection", port_num);
+		return;
+	}
+
 	if (port_instance->udev != NULL) {
 		udev = port_instance->udev;
 		port_instance->udev = NULL;
@@ -437,6 +444,15 @@ static void hub_port_process(struct usbh_hub_data *const hub_data,
 				return;
 			}
 
+			/* A device attached again is debounced before the next reset */
+			if ((port_sts.wPortChange & USB_HUB_PORT_CHANGE_CONNECTION) != 0 &&
+			    port_instance->reset_count > 0) {
+				LOG_WRN("Port %d connection changed during reset", port_num);
+				port_instance->state = PORT_STATE_DISCONNECTED;
+				k_sleep(K_MSEC(CONFIG_USBH_HUB_ENUM_RETRY_DELAY_MS));
+				continue;
+			}
+
 			if ((port_sts.wPortStatus & USB_HUB_PORT_STATUS_ENABLE) == 0) {
 				LOG_WRN("Port %d not enabled, status 0x%04x change 0x%04x",
 					port_num, port_sts.wPortStatus, port_sts.wPortChange);
-- 
