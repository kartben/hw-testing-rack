From c83c0fc3b7f3ba50ab5f1453b60784b7176d9e65 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Benjamin=20Cab=C3=A9?= <benjamin@zephyrproject.org>
Date: Wed, 21 Oct 2026 19:02:19 +0200
Subject: [PATCH 1/3] usb: host: hub: debounce the port connection before reset
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The port was reset as soon as a connection change was reported. Wait
for the connection status to be stable for TATTDB (100 ms, USB 2.0
7.1.7.3) first, as a device being plugged in or still powering up
makes and breaks the connection.

Signed-off-by: Benjamin Cabé <benjamin@zephyrproject.org>
Assisted-by: Claude:opus-5.5
---
 subsys/usb/host/class/usbh_hub.c | 65 +++++++++++++++++++++++++++++++-
 1 file changed, 64 insertions(+), 1 deletion(-)

diff --git a/subsys/usb/host/class/usbh_hub.c b/subsys/usb/host/class/usbh_hub.c
index 4ff82887351..5b8bdde3d61 100644
--- a/subsys/usb/host/class/usbh_hub.c
+++ b/subsys/usb/host/class/usbh_hub.c
@@ -19,6 +19,11 @@
 
 LOG_MODULE_REGISTER(usbh_hub, CONFIG_USBH_HUB_LOG_LEVEL);
 
+/* Connect debounce, TATTDB is 100 ms (USB 2.0, 7.1.7.3) */
+#define HUB_DEBOUNCE_STEP_MS		25
+#define HUB_DEBOUNCE_STABLE_MS		100
+#define HUB_DEBOUNCE_TIMEOUT_MS		1500
+
 static K_KERNEL_STACK_DEFINE(hub_stack, CONFIG_USBH_HUB_STACK_SIZE);
 static struct k_work_q hub_work_q;
 
@@ -273,11 +278,54 @@ static void hub_port_handle_change(struct usbh_hub_data *const hub_data,
 	}
 
 	LOG_DBG("Device connected to port %d, scheduling reset and enumeration", port_num);
-	port_instance->state = PORT_STATE_DISABLED;
+	port_instance->state = PORT_STATE_DISCONNECTED;
 	port_instance->reset_count = CONFIG_USBH_HUB_PORT_RESET_TIMES;
 	port_instance->enum_pending = true;
 }
 
+/*
+ * Wait until the port connection status has been stable for TATTDB. Returns 0
+ * if a device is connected, -ENOTCONN if the port is empty.
+ */
+static int hub_port_debounce(struct usbh_hub_data *const hub_data, const uint8_t port_num)
+{
+	uint16_t connection = UINT16_MAX;
+	uint16_t port_status;
+	uint16_t port_change;
+	int stable_ms = 0;
+	int ret;
+
+	for (int t = 0; t < HUB_DEBOUNCE_TIMEOUT_MS; t += HUB_DEBOUNCE_STEP_MS) {
+		ret = usbh_req_get_port_status(hub_data->udev, port_num,
+					       &port_status, &port_change);
+		if (ret != 0) {
+			return ret;
+		}
+
+		if ((port_change & USB_HUB_PORT_CHANGE_CONNECTION) == 0 &&
+		    (port_status & USB_HUB_PORT_STATUS_CONNECTION) == connection) {
+			stable_ms += HUB_DEBOUNCE_STEP_MS;
+			if (stable_ms >= HUB_DEBOUNCE_STABLE_MS) {
+				return connection != 0 ? 0 : -ENOTCONN;
+			}
+		} else {
+			stable_ms = 0;
+			connection = port_status & USB_HUB_PORT_STATUS_CONNECTION;
+		}
+
+		if ((port_change & USB_HUB_PORT_CHANGE_CONNECTION) != 0) {
+			ret = usbh_req_clear_hcfs_c_port_connection(hub_data->udev, port_num);
+			if (ret != 0) {
+				return ret;
+			}
+		}
+
+		k_msleep(HUB_DEBOUNCE_STEP_MS);
+	}
+
+	return -ETIMEDOUT;
+}
+
 static void hub_port_process(struct usbh_hub_data *const hub_data,
 			     struct usb_hub_port *const port_instance)
 {
@@ -292,6 +340,21 @@ static void hub_port_process(struct usbh_hub_data *const hub_data,
 
 	while (hub_data->connected) {
 		switch (port_instance->state) {
+		case PORT_STATE_DISCONNECTED:
+			ret = hub_port_debounce(hub_data, port_num);
+			if (ret == -ENOTCONN) {
+				LOG_DBG("Port %d disconnected", port_num);
+				return;
+			}
+
+			if (ret != 0) {
+				LOG_WRN("Port %d connect debounce failed: %d", port_num, ret);
+				return;
+			}
+
+			port_instance->state = PORT_STATE_DISABLED;
+			continue;
+
 		case PORT_STATE_DISABLED:
 			if (port_instance->reset_count == 0) {
 				LOG_ERR("Port %d reset retry count exhausted, giving up",
-- 
