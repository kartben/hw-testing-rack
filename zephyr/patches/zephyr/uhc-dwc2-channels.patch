From b56e4af634473f999c1d6d3d89e3bc3a2a54b6e8 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Benjamin=20Cab=C3=A9?= <benjamin@zephyrproject.org>
Date: Wed, 21 Oct 2026 22:07:58 +0200
Subject: [PATCH 09/11] drivers: usb: uhc_dwc2: count consecutive transaction
 errors only
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

A bulk or control IN transfer failed on the third transaction error of
its channel, even when the device had answered in between. A transfer
that waits on a slow device, such as a serial converter sending a few
bytes now and then, gathered sporadic errors until it failed, and the
data it had already received was lost with it.

Unmask the ACK and NAK interrupts after a transaction error, and start
the count over on the next handshake, so that only consecutive errors
fail the transfer.

Signed-off-by: Benjamin Cabé <benjamin@zephyrproject.org>
Assisted-by: Claude:opus-5.5
---
 drivers/usb/uhc/uhc_dwc2.c | 19 ++++++++++++-------
 1 file changed, 12 insertions(+), 7 deletions(-)

diff --git a/drivers/usb/uhc/uhc_dwc2.c b/drivers/usb/uhc/uhc_dwc2.c
index bdd398c3e0e..d032244974f 100644
--- a/drivers/usb/uhc/uhc_dwc2.c
+++ b/drivers/usb/uhc/uhc_dwc2.c
@@ -947,7 +947,9 @@ static uint32_t ch_handle_in_bulk_control(const struct device *dev,
 				ch_events |= BIT(UHC_DWC2_CHANNEL_DO_RELEASE);
 				ch_events |= BIT(UHC_DWC2_CHANNEL_EVENT_ERROR);
 			} else {
-				/* TODO: Unmask ACK, NAK, DTGERR */
+				/* Only consecutive errors count, the next handshake resets */
+				sys_set_bits((mem_addr_t)&ch->regs->hcintmsk,
+					     USB_DWC2_HCINT_ACK | USB_DWC2_HCINT_NAK);
 				LOG_DBG("IN channel%d error, HCINT 0x%08x, retry %u",
 					ch->index, hcint, ch->error_count);
 				ch_events |= BIT(UHC_DWC2_CHANNEL_DO_REINIT);
@@ -972,11 +974,14 @@ static uint32_t ch_handle_in_bulk_control(const struct device *dev,
 		}
 	} else if ((hcint & USB_DWC2_HCINT_NAK) && ch->xfer->type == USB_EP_TYPE_BULK) {
 		/*
-		 * NAK is unmasked while transfers wait for a channel (see
-		 * submit_pending()): if they still do, halt the channel and give
-		 * it to one of them. The core retries a NAKed bulk IN by itself.
+		 * NAK is unmasked after a transaction error, and while transfers
+		 * wait for a channel (see submit_pending()): if they still do, halt
+		 * the channel and give it to one of them. The core retries a NAKed
+		 * bulk IN by itself.
 		 */
-		sys_clear_bits((mem_addr_t)&ch->regs->hcintmsk, USB_DWC2_HCINT_NAK);
+		sys_clear_bits((mem_addr_t)&ch->regs->hcintmsk,
+			       USB_DWC2_HCINT_ACK | USB_DWC2_HCINT_NAK);
+		ch->error_count = 0;
 		if (atomic_get(&priv->waiting) && !ch->halt_park) {
 			ch->halt_park = true;
 			sys_set_bits((mem_addr_t)&ch->regs->hcchar,
@@ -984,8 +989,8 @@ static uint32_t ch_handle_in_bulk_control(const struct device *dev,
 		}
 	} else if (hcint & (USB_DWC2_HCINT_ACK | USB_DWC2_HCINT_NAK | USB_DWC2_HCINT_DTGERR)) {
 		ch->error_count = 0;
-		/* TODO: Mask ACK, NAK, DTGERR */
-		LOG_WRN("ACK, NAK or DTG Error");
+		sys_clear_bits((mem_addr_t)&ch->regs->hcintmsk,
+			       USB_DWC2_HCINT_ACK | USB_DWC2_HCINT_NAK);
 	} else {
 		/* TODO: Add handling for other cases */
 		LOG_WRN("IN not halted, unhandled HCINT 0x%08x", hcint);

From d34db146a6b026c59ef59a47921678438089a625 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Benjamin=20Cab=C3=A9?= <benjamin@zephyrproject.org>
Date: Wed, 21 Oct 2026 22:05:23 +0200
Subject: [PATCH 10/11] drivers: usb: uhc_dwc2: keep the data toggle of a
 cancelled transfer
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

A transfer cancelled after it had exchanged packets left the data
toggle of its endpoint behind. The next transfer of the endpoint then
started on the wrong toggle, and its first packet was taken for a
repeat and dropped. Take the toggle from the controller when a transfer
is cancelled, as when it ends otherwise.

Signed-off-by: Benjamin Cabé <benjamin@zephyrproject.org>
Assisted-by: Claude:opus-5.5
---
 drivers/usb/uhc/uhc_dwc2.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/drivers/usb/uhc/uhc_dwc2.c b/drivers/usb/uhc/uhc_dwc2.c
index d032244974f..a813e7a62c9 100644
--- a/drivers/usb/uhc/uhc_dwc2.c
+++ b/drivers/usb/uhc/uhc_dwc2.c
@@ -2482,6 +2482,7 @@ static void ch_handle_events(const struct device *dev, struct uhc_dwc2_channel *
 		/* CANCELLED, ERROR, STALL and COMPLETE are mutually exclusive */
 		if (events & BIT(UHC_DWC2_CHANNEL_EVENT_CANCELLED)) {
 			err = -ECONNRESET;
+			ch_save_toggle(ch);
 		} else if (events & BIT(UHC_DWC2_CHANNEL_EVENT_ERROR)) {
 			err = -EIO;
 			ch_save_toggle(ch);
@@ -2661,6 +2662,7 @@ static void dequeue_cancelled(const struct device *dev)
 				atomic_set(&ch->events, 0);
 				k_event_clear(&priv->events,
 					BIT(UHC_DWC2_EVENT_PORT_PEND_CHANNEL + ch->index));
+				ch_save_toggle(ch);
 				ch_release(dev, ch);
 			}
 

From 2271e98a2ca945b2da4bc51af287976582956a8a Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Benjamin=20Cab=C3=A9?= <benjamin@zephyrproject.org>
Date: Thu, 22 Oct 2026 12:23:37 +0200
Subject: [PATCH 11/11] drivers: usb: uhc_dwc2: split bulk transfers the
 channel counters cannot hold
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

A channel is programmed with the packet count and the size of the whole
transfer, but the width of these fields is chosen when the core is
synthesized: 7 and 16 bits on the ESP32-S3. A full-speed bulk transfer
of more than 127 packets, 8128 bytes, overflowed the packet count, and a
16 KB read from a mass storage device ended in a kernel panic.

Take the widths from GHWCFG3, program a channel with at most what they
hold, and start the next run of a bulk transfer where the last one
ended, until the transfer is done or the device sends a short packet.

Signed-off-by: Benjamin Cabé <benjamin@zephyrproject.org>
Assisted-by: Claude:opus-5.5
