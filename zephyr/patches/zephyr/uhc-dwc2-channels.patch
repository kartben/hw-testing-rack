From 208f2cd1795767cba23aa9b8331e70e779436f5f Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Benjamin=20Cab=C3=A9?= <benjamin@zephyrproject.org>
Date: Tue, 8 Sep 2026 14:48:44 +0200
Subject: [PATCH 01/11] drivers: usb: uhc_dwc2: take the bulk data toggle from
 the controller
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The next PID was computed from the bytes transferred, which misses the
zero length packet ending a transfer of a multiple of the maximum packet
size. Following transfers then start on the wrong toggle, and the
controller acknowledges and discards their first packet as a repeat.
Read the PID back from HCTSIZ instead.

Signed-off-by: Benjamin Cabé <benjamin@zephyrproject.org>
Assisted-by: Claude:opus-5
(cherry picked from commit 1e7efcef396dbbdd585871f8a06a8ce553d54c6a)
---
 drivers/usb/uhc/uhc_dwc2.c | 34 ++++++++++++++++++----------------
 1 file changed, 18 insertions(+), 16 deletions(-)

diff --git a/drivers/usb/uhc/uhc_dwc2.c b/drivers/usb/uhc/uhc_dwc2.c
index 92f23d7436c..34f79b5ccd5 100644
--- a/drivers/usb/uhc/uhc_dwc2.c
+++ b/drivers/usb/uhc/uhc_dwc2.c
@@ -200,18 +200,6 @@ static inline uint32_t calc_packet_count(const uint32_t size, const uint16_t mps
 	}
 }
 
-static inline uint8_t calc_next_pid(const uint8_t pid, const uint32_t pkt_cnt)
-{
-	/* If amount of packets are even - do not toggle */
-	if ((pkt_cnt & BIT(0)) == 0) {
-		return pid;
-	}
-
-	return (pid == USB_DWC2_HCTSIZ_PID_DATA0) ?
-		USB_DWC2_HCTSIZ_PID_DATA1 :
-		USB_DWC2_HCTSIZ_PID_DATA0;
-}
-
 static inline bool periodic_frame_overrun(uint16_t current_frame, uint16_t scheduled_frame)
 {
 	uint16_t delta;
@@ -1311,11 +1299,27 @@ static int ch_configure(const struct device *const dev, struct uhc_dwc2_channel
 	return 0;
 }
 
+/*
+ * The core writes the PID of the next packet back to HCTSIZ when a channel
+ * halts, zero length packets included. Control transfers derive their PID
+ * from the stage instead.
+ */
+static void ch_save_toggle(struct uhc_dwc2_channel *const ch)
+{
+	uint32_t hctsiz;
+
+	if (ch->xfer->type == USB_EP_TYPE_CONTROL) {
+		return;
+	}
+
+	hctsiz = sys_read32((mem_addr_t)&ch->regs->hctsiz);
+	ch->data->next_pid = usb_dwc2_get_hctsiz_pid(hctsiz);
+}
+
 static void ch_complete_data(const struct device *dev, struct uhc_dwc2_channel *const ch)
 {
 	struct uhc_transfer *const xfer = ch->xfer;
 	uint32_t actual_len = ch->length;
-	uint32_t pkt_cnt;
 	uint32_t hctsiz;
 	uint32_t remaining;
 
@@ -1330,9 +1334,7 @@ static void ch_complete_data(const struct device *dev, struct uhc_dwc2_channel *
 		net_buf_add(xfer->buf, actual_len);
 	}
 
-	/* Precalculate next pid based on the packets actually transferred */
-	pkt_cnt = calc_packet_count(actual_len, xfer->mps);
-	ch->data->next_pid = calc_next_pid(ch->data->next_pid, pkt_cnt);
+	ch_save_toggle(ch);
 
 	LOG_DBG("Data on channel%u, prog=%u, act=%u, len=%u, mps=%u, next_pid=%u",
 		ch->index, ch->length, actual_len, xfer->buf->len,

From 83898846708a0577ada833691905bb58005425bb Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Benjamin=20Cab=C3=A9?= <benjamin@zephyrproject.org>
Date: Tue, 8 Sep 2026 14:31:27 +0200
Subject: [PATCH 02/11] drivers: usb: uhc_dwc2: rewind bulk transfers instead
 of restarting them
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

A bulk transfer retried after a transaction error restarted from the
start of its buffer with the toggle it was queued with, although the
device may already have accepted some of its packets. Those packets were
then sent or received twice, or the retry was dropped as a repeat.

Resume from the first packet the device has not acknowledged, with the
toggle the core reports: PKTCNT counts only completed packets, and every
packet but the last is maximum sized. Request the rewind for IN errors
too, and keep the toggle when a transfer is given up on.

Not reached by the traffic this was tested with, and HCDMA cannot
confirm it as the DMA engine rounds its address up to a word.

Signed-off-by: Benjamin Cabé <benjamin@zephyrproject.org>
Assisted-by: Claude:opus-5
(cherry picked from commit 21b476034d1a4d0cc9ed221697c3c7d097fb0d87)
---
 drivers/usb/uhc/uhc_dwc2.c | 50 ++++++++++++++++++++++++++++++++++++--
 1 file changed, 48 insertions(+), 2 deletions(-)

diff --git a/drivers/usb/uhc/uhc_dwc2.c b/drivers/usb/uhc/uhc_dwc2.c
index 34f79b5ccd5..fdc36853d33 100644
--- a/drivers/usb/uhc/uhc_dwc2.c
+++ b/drivers/usb/uhc/uhc_dwc2.c
@@ -919,6 +919,7 @@ static uint32_t ch_handle_in_bulk_control(const struct device *dev,
 				LOG_DBG("IN channel%d error, HCINT 0x%08x, retry %u",
 					ch->index, hcint, ch->error_count);
 				ch_events |= BIT(UHC_DWC2_CHANNEL_DO_REINIT);
+				ch_events |= BIT(UHC_DWC2_CHANNEL_DO_REWIND);
 			}
 		} else {
 			/* The channel halted without reporting a reason. Fail the
@@ -1341,6 +1342,51 @@ static void ch_complete_data(const struct device *dev, struct uhc_dwc2_channel *
 		xfer->mps, ch->data->next_pid);
 }
 
+/*
+ * Restart a halted bulk transfer where the wire left off instead of from the
+ * beginning. PKTCNT is only decremented for packets that completed their
+ * transaction, and every packet but the last one of a transfer is maximum
+ * sized, so it gives the amount of data the device has already seen.
+ */
+static void ch_rewind_bulk(struct uhc_dwc2_channel *const ch)
+{
+	struct uhc_transfer *const xfer = ch->xfer;
+	uint32_t pkt_cnt;
+	uint32_t remaining;
+	uint32_t xfered;
+
+	if (xfer->type != USB_EP_TYPE_BULK) {
+		return;
+	}
+
+	pkt_cnt = calc_packet_count(ch->length, xfer->mps);
+	remaining = usb_dwc2_get_hctsiz_pktcnt(sys_read32((mem_addr_t)&ch->regs->hctsiz));
+
+	ch_save_toggle(ch);
+
+	if (remaining > pkt_cnt) {
+		LOG_ERR("Channel%u PKTCNT %u above programmed %u",
+			ch->index, remaining, pkt_cnt);
+		return;
+	}
+
+	xfered = MIN((pkt_cnt - remaining) * xfer->mps, ch->length);
+	if (xfered == 0U) {
+		return;
+	}
+
+	LOG_DBG("Rewind channel%u, xfered=%u of %u, next_pid=%u",
+		ch->index, xfered, ch->length, ch->data->next_pid);
+
+	if (USB_EP_DIR_IS_IN(xfer->ep)) {
+		/* Keep what was received and resume into the tailroom */
+		sys_cache_data_invd_range(net_buf_tail(xfer->buf), xfered);
+		net_buf_add(xfer->buf, xfered);
+	} else {
+		net_buf_pull(xfer->buf, xfered);
+	}
+}
+
 static void ch_complete(const struct device *dev, struct uhc_dwc2_channel *const ch)
 {
 	struct uhc_transfer *const xfer = ch->xfer;
@@ -2123,6 +2169,7 @@ static void ch_handle_events(const struct device *dev, struct uhc_dwc2_channel *
 			err = -ECONNRESET;
 		} else if (events & BIT(UHC_DWC2_CHANNEL_EVENT_ERROR)) {
 			err = -EIO;
+			ch_save_toggle(ch);
 		} else if (events & BIT(UHC_DWC2_CHANNEL_EVENT_STALL)) {
 			err = -EPIPE;
 		} else if (events & BIT(UHC_DWC2_CHANNEL_EVENT_CPLT)) {
@@ -2138,8 +2185,7 @@ static void ch_handle_events(const struct device *dev, struct uhc_dwc2_channel *
 	} else {
 		/* Reinit/rewind transfer */
 		if (events & BIT(UHC_DWC2_CHANNEL_DO_REWIND)) {
-			/* TODO: Implement rewind xfer */
-			LOG_WRN("DO_REWIND not implemented yet");
+			ch_rewind_bulk(ch);
 		}
 
 		if (events & BIT(UHC_DWC2_CHANNEL_DO_REINIT)) {

From 0506fdc281b9186d2bfae558c438ef8cfd3a20a1 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Benjamin=20Cab=C3=A9?= <benjamin@zephyrproject.org>
Date: Thu, 1 Oct 2026 11:57:44 +0200
Subject: [PATCH 03/11] drivers: usb: uhc_dwc2: resume a bulk IN transfer after
 a toggle error
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

A device that repeats a packet whose ACK it missed makes the core
acknowledge and drop it, then halt the channel with DTGERR. A bulk IN
channel took that for a halt without a reason and failed the transfer.
Resume it from what has been received, with the toggle the core now
expects. Seen behind a GL850G hub on an ESP32-P4.

Signed-off-by: Benjamin Cabé <benjamin@zephyrproject.org>
Assisted-by: Claude:opus-5.5
(cherry picked from commit bb402406367c915a59965c11b3ff18f103eeb141)
---
 drivers/usb/uhc/uhc_dwc2.c | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/drivers/usb/uhc/uhc_dwc2.c b/drivers/usb/uhc/uhc_dwc2.c
index fdc36853d33..af5e6f53ac3 100644
--- a/drivers/usb/uhc/uhc_dwc2.c
+++ b/drivers/usb/uhc/uhc_dwc2.c
@@ -921,6 +921,12 @@ static uint32_t ch_handle_in_bulk_control(const struct device *dev,
 				ch_events |= BIT(UHC_DWC2_CHANNEL_DO_REINIT);
 				ch_events |= BIT(UHC_DWC2_CHANNEL_DO_REWIND);
 			}
+		} else if ((hcint & USB_DWC2_HCINT_DTGERR) && ch->xfer->type == USB_EP_TYPE_BULK) {
+			/* The core acknowledged and dropped a repeated packet */
+			ch->error_count = 0U;
+			LOG_DBG("IN channel%d toggle error, HCINT 0x%08x", ch->index, hcint);
+			ch_events |= BIT(UHC_DWC2_CHANNEL_DO_REINIT);
+			ch_events |= BIT(UHC_DWC2_CHANNEL_DO_REWIND);
 		} else {
 			/* The channel halted without reporting a reason. Fail the
 			 * transfer instead of leaving the caller waiting.

From 5179ddc232eda51c1b9f4319a8a1d32a8c3eb6e6 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Benjamin=20Cab=C3=A9?= <benjamin@zephyrproject.org>
Date: Tue, 29 Sep 2026 15:42:36 +0200
Subject: [PATCH 04/11] drivers: usb: uhc_dwc2: reset the data toggles on a
 configuration
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

A device returns all its endpoints to DATA0 when it is configured, but
the toggles the driver tracks per device and endpoint were only dropped
on a root port reset. A device behind a hub that reuses the struct
usb_device of one that was removed, as a phone re-enumerating in
accessory mode does, then starts with the old device's toggles.

Drop the endpoint state of a device when a standard SET_CONFIGURATION
request to it completes. Tested with an Android phone switching to
accessory mode behind a USB hub on an ESP32-P4 board.

Signed-off-by: Benjamin Cabé <benjamin@zephyrproject.org>
Assisted-by: Claude:opus-5.5
(cherry picked from commit b34343fdc64372160f24d618e9436ab61adcc574)
---
 drivers/usb/uhc/uhc_dwc2.c | 21 +++++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/drivers/usb/uhc/uhc_dwc2.c b/drivers/usb/uhc/uhc_dwc2.c
index af5e6f53ac3..75a1aa2ef4e 100644
--- a/drivers/usb/uhc/uhc_dwc2.c
+++ b/drivers/usb/uhc/uhc_dwc2.c
@@ -1393,8 +1393,25 @@ static void ch_rewind_bulk(struct uhc_dwc2_channel *const ch)
 	}
 }
 
+/*
+ * A device returns every endpoint to DATA0 when it is configured, so the state
+ * kept for its endpoints goes with it. This also covers a device that reuses
+ * the struct usb_device of one that was removed.
+ */
+static void ch_data_drop_device(struct uhc_dwc2_data *const priv, struct usb_device *const udev)
+{
+	for (uint8_t idx = 0; idx < ARRAY_SIZE(priv->ch_data); idx++) {
+		struct uhc_dwc2_channel_data *data = &priv->ch_data[idx];
+
+		if (data->udev == udev && USB_EP_GET_IDX(data->ep) != 0U) {
+			*data = (struct uhc_dwc2_channel_data) {0};
+		}
+	}
+}
+
 static void ch_complete(const struct device *dev, struct uhc_dwc2_channel *const ch)
 {
+	struct uhc_dwc2_data *const priv = uhc_get_private(dev);
 	struct uhc_transfer *const xfer = ch->xfer;
 	const struct usb_setup_packet *setup;
 
@@ -1405,6 +1422,10 @@ static void ch_complete(const struct device *dev, struct uhc_dwc2_channel *const
 		if (setup->bRequest == USB_SREQ_SET_ADDRESS) {
 			k_msleep(SET_ADDR_DELAY_MS);
 		}
+		if (setup->bRequest == USB_SREQ_SET_CONFIGURATION &&
+		    setup->RequestType.type == USB_REQTYPE_TYPE_STANDARD) {
+			ch_data_drop_device(priv, xfer->udev);
+		}
 		break;
 	case USB_EP_TYPE_BULK:
 	case USB_EP_TYPE_INTERRUPT:

From f594e0445fe8a37162148b763ce2dbfdca02556d Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Benjamin=20Cab=C3=A9?= <benjamin@zephyrproject.org>
Date: Fri, 9 Oct 2026 12:26:16 +0200
Subject: [PATCH 05/11] drivers: usb: uhc_dwc2: reset the data toggle when a
 halt is cleared
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

A ClearFeature(ENDPOINT_HALT) request returns the endpoint's data toggle
to DATA0, whether it was halted or not (USB 2.0, 9.4.5), but the driver
kept the toggle it tracked for the endpoint. The next transaction then
used the wrong toggle and its data was discarded as a retransmission.

Drop the state kept for the endpoint when a standard ClearFeature
(ENDPOINT_HALT) request to it completes.

Signed-off-by: Benjamin Cabé <benjamin@zephyrproject.org>
Assisted-by: Claude:opus-5.5
(cherry picked from commit e276b6a1b7f8f80f540cc18b0e8dde2fb126e8ea)
---
 drivers/usb/uhc/uhc_dwc2.c | 23 +++++++++++++++++++++++
 1 file changed, 23 insertions(+)

diff --git a/drivers/usb/uhc/uhc_dwc2.c b/drivers/usb/uhc/uhc_dwc2.c
index 75a1aa2ef4e..47c85c63344 100644
--- a/drivers/usb/uhc/uhc_dwc2.c
+++ b/drivers/usb/uhc/uhc_dwc2.c
@@ -1409,6 +1409,23 @@ static void ch_data_drop_device(struct uhc_dwc2_data *const priv, struct usb_dev
 	}
 }
 
+/* Clearing a halt returns that endpoint to DATA0, halted or not (USB 2.0, 9.4.5) */
+static void ch_data_drop_ep(struct uhc_dwc2_data *const priv, struct usb_device *const udev,
+			    const uint8_t ep)
+{
+	if (USB_EP_GET_IDX(ep) == 0U) {
+		return;
+	}
+
+	for (uint8_t idx = 0; idx < ARRAY_SIZE(priv->ch_data); idx++) {
+		struct uhc_dwc2_channel_data *data = &priv->ch_data[idx];
+
+		if (data->udev == udev && data->ep == ep) {
+			*data = (struct uhc_dwc2_channel_data) {0};
+		}
+	}
+}
+
 static void ch_complete(const struct device *dev, struct uhc_dwc2_channel *const ch)
 {
 	struct uhc_dwc2_data *const priv = uhc_get_private(dev);
@@ -1426,6 +1443,12 @@ static void ch_complete(const struct device *dev, struct uhc_dwc2_channel *const
 		    setup->RequestType.type == USB_REQTYPE_TYPE_STANDARD) {
 			ch_data_drop_device(priv, xfer->udev);
 		}
+		if (setup->bRequest == USB_SREQ_CLEAR_FEATURE &&
+		    setup->RequestType.type == USB_REQTYPE_TYPE_STANDARD &&
+		    setup->RequestType.recipient == USB_REQTYPE_RECIPIENT_ENDPOINT &&
+		    sys_le16_to_cpu(setup->wValue) == USB_SFS_ENDPOINT_HALT) {
+			ch_data_drop_ep(priv, xfer->udev, (uint8_t)sys_le16_to_cpu(setup->wIndex));
+		}
 		break;
 	case USB_EP_TYPE_BULK:
 	case USB_EP_TYPE_INTERRUPT:

From e14305abf15c2572f9932bfaba5d556fa995dc74 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Benjamin=20Cab=C3=A9?= <benjamin@zephyrproject.org>
Date: Mon, 19 Oct 2026 19:13:42 +0200
Subject: [PATCH 06/11] drivers: usb: uhc_dwc2: keep the endpoint state by
 device address
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The state of an endpoint (data toggle, interrupt schedule) was kept by
struct usb_device pointer and freed only on a root port reset. Behind a
hub, devices go without the controller knowing: their slots leak until
"No channel data slot", and a device allocated at the same pointer
inherits the toggles of the one that was removed.

Keep the state by device address instead, and drop the state found at an
address when SET_ADDRESS gives it to a device: the slots of a removed
device are freed at the latest when its address is reused. A slot in use
by a channel only gets its toggle reset. Look the slot up before taking a
channel, so that a missing slot no longer leaves the channel busy.

Assisted-by: Claude:opus-5.5
Signed-off-by: Benjamin Cabé <benjamin@zephyrproject.org>
---
 drivers/usb/uhc/uhc_dwc2.c | 91 ++++++++++++++++++++++++++++----------
 1 file changed, 68 insertions(+), 23 deletions(-)

diff --git a/drivers/usb/uhc/uhc_dwc2.c b/drivers/usb/uhc/uhc_dwc2.c
index 47c85c63344..fca3a4e4904 100644
--- a/drivers/usb/uhc/uhc_dwc2.c
+++ b/drivers/usb/uhc/uhc_dwc2.c
@@ -99,8 +99,10 @@ enum uhc_dwc2_channel_event {
 
 /* TODO: rename to pipe_data and expand with udev or to move one level higher */
 struct uhc_dwc2_channel_data {
-	/* Device this endpoint state belongs to */
-	struct usb_device *udev;
+	/* The slot holds the state of an endpoint */
+	bool used;
+	/* Address of the device this endpoint state belongs to */
+	uint8_t addr;
 	/* Endpoint address this state belongs to */
 	uint8_t ep;
 	/* PID value, used for the next data stage transfer */
@@ -160,20 +162,26 @@ struct usb_dwc2_reg *uhc_dwc2_get_base(const struct device *dev)
 	return (struct usb_dwc2_reg *)DEVICE_MMIO_NAMED_GET(dev, core);
 }
 
+/*
+ * The state of an endpoint is kept by device address: the address is unique
+ * on the bus while the device is there, and a device that is gone leaves its
+ * state at an address that the next device given that address takes over
+ * (see ch_complete()). A struct usb_device can be reused for another device.
+ */
 static struct uhc_dwc2_channel_data *ch_data_get(struct uhc_dwc2_data *priv,
-						 struct usb_device *udev,
-						 uint8_t ep)
+						 const uint8_t addr,
+						 const uint8_t ep)
 {
 	struct uhc_dwc2_channel_data *ch_data = NULL;
 
 	for (uint8_t idx = 0; idx < ARRAY_SIZE(priv->ch_data); idx++) {
 		struct uhc_dwc2_channel_data *data = &priv->ch_data[idx];
 
-		if (data->udev == udev && data->ep == ep) {
+		if (data->used && data->addr == addr && data->ep == ep) {
 			return data;
 		}
 
-		if (data->udev == NULL && ch_data == NULL) {
+		if (!data->used && ch_data == NULL) {
 			ch_data = data;
 		}
 	}
@@ -183,7 +191,8 @@ static struct uhc_dwc2_channel_data *ch_data_get(struct uhc_dwc2_data *priv,
 	}
 
 	*ch_data = (struct uhc_dwc2_channel_data) {
-		.udev = udev,
+		.used = true,
+		.addr = addr,
 		.ep = ep,
 		.next_pid = USB_DWC2_HCTSIZ_PID_DATA0,
 	};
@@ -1205,6 +1214,7 @@ static int ch_claim(const struct device *const dev,
 		    struct uhc_dwc2_channel **const ch_p)
 {
 	struct uhc_dwc2_data *const priv = uhc_get_private(dev);
+	struct uhc_dwc2_channel_data *data;
 	struct uhc_dwc2_channel *ch = NULL;
 
 	/* A non-NULL xfer marks the channel as busy. Scan all channels:
@@ -1234,6 +1244,12 @@ static int ch_claim(const struct device *const dev,
 		return -EBUSY;
 	}
 
+	data = ch_data_get(priv, xfer->udev->addr, xfer->ep);
+	if (data == NULL) {
+		LOG_ERR("No channel data slot for addr %u ep 0x%02x", xfer->udev->addr, xfer->ep);
+		return -ENOMEM;
+	}
+
 	LOG_DBG("Claimed channel%d for ep 0x%02x, xfer=%p, channel=%p",
 		ch->index, xfer->ep, (void *)xfer, (void *)ch);
 
@@ -1242,12 +1258,7 @@ static int ch_claim(const struct device *const dev,
 
 	/* Save channel characteristics of the underlying channel */
 	ch->xfer = xfer;
-	ch->data = ch_data_get(priv, xfer->udev, xfer->ep);
-
-	if (ch->data == NULL) {
-		LOG_ERR("No channel data slot for addr %u ep 0x%02x", xfer->udev->addr, xfer->ep);
-		return -ENOMEM;
-	}
+	ch->data = data;
 
 	ch->data->scheduled_frame = 0;
 	ch->data->periodic_started = false;
@@ -1393,24 +1404,40 @@ static void ch_rewind_bulk(struct uhc_dwc2_channel *const ch)
 	}
 }
 
+/*
+ * Forget the state of an endpoint: back to DATA0 and no schedule. A slot that a
+ * channel is using keeps its place, the others are free again.
+ */
+static void ch_data_forget(struct uhc_dwc2_data *const priv,
+			   struct uhc_dwc2_channel_data *const data)
+{
+	for (uint32_t idx = 0; idx < priv->numhstchnl; idx++) {
+		if (priv->ch[idx].data == data) {
+			data->next_pid = USB_DWC2_HCTSIZ_PID_DATA0;
+			return;
+		}
+	}
+
+	*data = (struct uhc_dwc2_channel_data) {0};
+}
+
 /*
  * A device returns every endpoint to DATA0 when it is configured, so the state
- * kept for its endpoints goes with it. This also covers a device that reuses
- * the struct usb_device of one that was removed.
+ * kept for its endpoints goes with it.
  */
-static void ch_data_drop_device(struct uhc_dwc2_data *const priv, struct usb_device *const udev)
+static void ch_data_drop_device(struct uhc_dwc2_data *const priv, const uint8_t addr)
 {
 	for (uint8_t idx = 0; idx < ARRAY_SIZE(priv->ch_data); idx++) {
 		struct uhc_dwc2_channel_data *data = &priv->ch_data[idx];
 
