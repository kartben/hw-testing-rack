From 9c4ddffc6766bafac5e1cd7a32c68600b43c88e5 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Benjamin=20Cab=C3=A9?= <benjamin@zephyrproject.org>
Date: Mon, 19 Oct 2026 13:28:24 +0200
Subject: [PATCH 1/9] usb: usbip: check the result of the UHC transfer
 allocation
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The transfer allocation is retried a few times, but if it still fails,
the transfer pointer is dereferenced anyway. Return -ENOMEM instead.

Assisted-by: Claude:opus-5.5
Signed-off-by: Benjamin Cabé <benjamin@zephyrproject.org>
---
 subsys/usb/host/usbip.c | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/subsys/usb/host/usbip.c b/subsys/usb/host/usbip.c
index 4fe6f2ab1ab..c52381d13e3 100644
--- a/subsys/usb/host/usbip.c
+++ b/subsys/usb/host/usbip.c
@@ -231,6 +231,11 @@ static int usbip_submit_req(struct usbip_cmd_node *const cmd_nd, const uint8_t e
 		}
 	} while (xfer == NULL && retry--);
 
+	if (xfer == NULL) {
+		LOG_ERR("Failed to allocate transfer");
+		return -ENOMEM;
+	}
+
 	if (setup != NULL) {
 		memcpy(xfer->setup_pkt, setup, sizeof(struct usb_setup_packet));
 		LOG_HEXDUMP_DBG(xfer->setup_pkt, 8U, "setup");

From 84492496a1e8a52c54ad2ef0551ea762d0e52344 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Benjamin=20Cab=C3=A9?= <benjamin@zephyrproject.org>
Date: Mon, 19 Oct 2026 13:28:25 +0200
Subject: [PATCH 2/9] usb: usbip: clean up if request submission fails
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

If the request submission fails, the command node remains in the list
and neither the node nor the buffer is released. Remove the node from
the list, free the slab and the buffer. buf may be NULL, check it in the
slab allocation failure path too.

The completion callback removes nodes from the list with interrupts
locked, append to the list with interrupts locked as well.

Assisted-by: Claude:opus-5.5
Signed-off-by: Benjamin Cabé <benjamin@zephyrproject.org>
---
 subsys/usb/host/usbip.c | 16 +++++++++++++++-
 1 file changed, 15 insertions(+), 1 deletion(-)

diff --git a/subsys/usb/host/usbip.c b/subsys/usb/host/usbip.c
index c52381d13e3..af4201c5890 100644
--- a/subsys/usb/host/usbip.c
+++ b/subsys/usb/host/usbip.c
@@ -270,6 +270,7 @@ static int usbip_handle_submit(struct usbip_dev_ctx *const dev_ctx,
 	struct usb_setup_packet setup = {0};
 	struct usbip_cmd_node *cmd_nd;
 	struct net_buf *buf = NULL;
+	unsigned int key;
 	uint8_t ep;
 	int ret;
 
@@ -323,18 +324,31 @@ static int usbip_handle_submit(struct usbip_dev_ctx *const dev_ctx,
 
 	if (k_mem_slab_alloc(&usbip_slab, (void **)&cmd_nd, K_MSEC(1000)) != 0) {
 		LOG_ERR("Failed to allocate slab");
-		net_buf_unref(buf);
+		if (buf != NULL) {
+			net_buf_unref(buf);
+		}
+
 		return -ENOMEM;
 	}
 
 	/* Make a copy of the command and add it to the backlog */
 	memcpy(&cmd_nd->cmd, cmd, sizeof(struct usbip_command));
 	cmd_nd->ctx = dev_ctx;
+	key = irq_lock();
 	sys_dlist_append(&dev_ctx->dlist, &cmd_nd->node);
+	irq_unlock(key);
 
 	ret = usbip_submit_req(cmd_nd, ep, &setup, buf);
 	if (ret != 0) {
 		LOG_ERR("Failed to submit request %d", ret);
+		key = irq_lock();
+		sys_dlist_remove(&cmd_nd->node);
+		irq_unlock(key);
+		k_mem_slab_free(&usbip_slab, (void *)cmd_nd);
+		if (buf != NULL) {
+			net_buf_unref(buf);
+		}
+
 		return ret;
 	}
 

From 2c3139fd76c5e4268e2f36e9f834bdad0ad19dbd Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Benjamin=20Cab=C3=A9?= <benjamin@zephyrproject.org>
Date: Mon, 19 Oct 2026 13:28:25 +0200
Subject: [PATCH 3/9] usb: usbip: dequeue pending transfers when the connection
 is closed
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

When the client closes the connection, transfers it submitted may still
be pending, for example an interrupt IN transfer that the device does
not answer. Such a transfer remains queued until the device completes
it, and only then is dropped. Dequeue all pending transfers of the
device context when the connection is closed.

Assisted-by: Claude:opus-5.5
Signed-off-by: Benjamin Cabé <benjamin@zephyrproject.org>
---
 subsys/usb/host/usbip.c | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/subsys/usb/host/usbip.c b/subsys/usb/host/usbip.c
index af4201c5890..42d32e1e83b 100644
--- a/subsys/usb/host/usbip.c
+++ b/subsys/usb/host/usbip.c
@@ -424,6 +424,19 @@ static int usbip_handle_cmd(struct usbip_dev_ctx *const dev_ctx)
 	return ret;
 }
 
+/* Pending transfers are completed with -ECONNRESET */
+static void usbip_dequeue_all(struct usbip_dev_ctx *const dev_ctx)
+{
+	struct usbip_cmd_node *cmd_nd;
+	unsigned int key;
+
+	key = irq_lock();
+	SYS_DLIST_FOR_EACH_CONTAINER(&dev_ctx->dlist, cmd_nd, node) {
+		(void)usbh_xfer_dequeue(dev_ctx->udev, cmd_nd->xfer);
+	}
+	irq_unlock(key);
+}
+
 static void usbip_thread_cmd(void *const a, void *const b, void *const c)
 {
 	struct usbip_dev_ctx *dev_ctx = a;
@@ -436,6 +449,7 @@ static void usbip_thread_cmd(void *const a, void *const b, void *const c)
 		ret = usbip_handle_cmd(dev_ctx);
 
 		if (ret) {
+			usbip_dequeue_all(dev_ctx);
 			zsock_close(dev_ctx->connfd);
 			LOG_INF("CMD connection closed, errno %d", ret);
 			k_event_set_masked(&dev_ctx->event, 0, USBIP_EXPORTED);

From 817ae599f024daf38648e043beff2a7dcf67485a Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Benjamin=20Cab=C3=A9?= <benjamin@zephyrproject.org>
Date: Mon, 19 Oct 2026 13:28:26 +0200
Subject: [PATCH 4/9] usb: usbip: drop completions of a previous connection
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

A transfer may complete after its connection has been closed and the
device has been imported again. The completion callback only checks
whether the device is exported, and would send USBIP_RET_SUBMIT to the
new client. Count the imports and drop completions that belong to an
earlier one.

Assisted-by: Claude:opus-5.5
Signed-off-by: Benjamin Cabé <benjamin@zephyrproject.org>
---
 subsys/usb/host/usbip.c | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/subsys/usb/host/usbip.c b/subsys/usb/host/usbip.c
index 42d32e1e83b..a2988b4dc79 100644
--- a/subsys/usb/host/usbip.c
+++ b/subsys/usb/host/usbip.c
@@ -47,6 +47,8 @@ struct usbip_dev_ctx {
 	sys_dlist_t dlist;
 	int connfd;
 	uint32_t devid;
+	/* Incremented on each import, to drop completions of an earlier one */
+	uint32_t session;
 };
 
 /* Context of the exported bus (not really used yet) */
@@ -64,6 +66,7 @@ struct usbip_cmd_node {
 	struct usbip_command cmd;
 	struct usbip_dev_ctx *ctx;
 	struct uhc_transfer *xfer;
+	uint32_t session;
 };
 
 K_MEM_SLAB_DEFINE_TYPE(usbip_slab, struct usbip_cmd_node,
@@ -154,7 +157,8 @@ static int usbip_req_cb(struct usb_device *const udev, struct uhc_transfer *cons
 		goto usbip_req_cb_error;
 	}
 
-	if (!k_event_wait(&dev_ctx->event, USBIP_EXPORTED, false, K_NO_WAIT)) {
+	if (!k_event_wait(&dev_ctx->event, USBIP_EXPORTED, false, K_NO_WAIT) ||
+	    cmd_nd->session != dev_ctx->session) {
 		LOG_WRN("Connection closed, drop completed seqnum %u", cmd->hdr.seqnum);
 		goto usbip_req_cb_error;
 	}
@@ -334,6 +338,7 @@ static int usbip_handle_submit(struct usbip_dev_ctx *const dev_ctx,
 	/* Make a copy of the command and add it to the backlog */
 	memcpy(&cmd_nd->cmd, cmd, sizeof(struct usbip_command));
 	cmd_nd->ctx = dev_ctx;
+	cmd_nd->session = dev_ctx->session;
 	key = irq_lock();
 	sys_dlist_append(&dev_ctx->dlist, &cmd_nd->node);
 	irq_unlock(key);
@@ -643,6 +648,7 @@ static int usbip_handle_import(struct usbip_bus_ctx *const bus_ctx, int connfd)
 	}
 
 	dev_ctx->connfd = connfd;
+	dev_ctx->session++;
 	k_event_post(&dev_ctx->event, USBIP_EXPORTED);
 	LOG_INF("USB device %s exported", busid);
 

