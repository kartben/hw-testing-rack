 1 file changed, 324 insertions(+), 127 deletions(-)

diff --git a/subsys/usb/host/usbip.c b/subsys/usb/host/usbip.c
index 4fe6f2ab1..2e337750a 100644
--- a/subsys/usb/host/usbip.c
+++ b/subsys/usb/host/usbip.c
@@ -10,9 +10,11 @@
 #include <zephyr/sys/byteorder.h>
 #include <zephyr/usb/usb_ch9.h>
 #include <zephyr/usb/usbh.h>
+#include <zephyr/usb/class/usb_hub.h>
 #include <zephyr/net/socket.h>
 #include <zephyr/net_buf.h>
 
+#include <usbh_class.h>
 #include <usbh_device.h>
 #include <usbh_ch9.h>
 #include <usbip.h>
@@ -35,18 +37,35 @@ K_THREAD_STACK_ARRAY_DEFINE(dev_thread_stacks, CONFIG_USBIP_DEVICES_COUNT,
 
 static struct k_thread usbip_thread;
 
-#define USBIP_DEFAULT_PATH	"/sys/bus/usb/devices/usb1/1-"
+#define USBIP_DEFAULT_PATH	"/sys/bus/usb/devices/usb1/"
+
+/* Hubs between the root port and a device, at most (USB 2.0, 4.1.1) */
+#define USBIP_HUB_TIERS_MAX	5
 
 #define USBIP_EXPORTED		BIT(0)
+/* The exported device was removed, the session is over */
+#define USBIP_REMOVED		BIT(1)
+
+/* How often a session waiting for a command checks that its device is there */
+#define USBIP_IDLE_CHECK_MS	250
 
-/* Context of the exported device */
+/*
+ * Context of a device that can be exported. Each one is a host class
+ * instance: the stack binds it to a device when the device is configured and
+ * tells it when the device is removed.
+ */
 struct usbip_dev_ctx {
+	/* The device bound to this context, or NULL */
 	struct usb_device *udev;
+	/* Protects udev against the removal of the device */
+	struct k_mutex lock;
 	struct k_thread thread;
 	struct k_event event;
 	sys_dlist_t dlist;
 	int connfd;
 	uint32_t devid;
+	/* Counts the imports, to tell the completions of an earlier session */
+	uint32_t session;
 };
 
 /* Context of the exported bus (not really used yet) */
@@ -64,11 +83,47 @@ struct usbip_cmd_node {
 	struct usbip_command cmd;
 	struct usbip_dev_ctx *ctx;
 	struct uhc_transfer *xfer;
+	uint32_t session;
 };
 
 K_MEM_SLAB_DEFINE_TYPE(usbip_slab, struct usbip_cmd_node,
 		       CONFIG_USBIP_SUBMIT_BACKLOG_COUNT);
 
+static int usbip_class_init(struct usbh_class_data *const c_data);
+static int usbip_class_probe(struct usbh_class_data *const c_data,
+			     struct usb_device *const udev, const uint8_t iface);
+static int usbip_class_removed(struct usbh_class_data *const c_data);
+
+static struct usbh_class_api usbip_class_api = {
+	.init = usbip_class_init,
+	.probe = usbip_class_probe,
+	.removed = usbip_class_removed,
+};
+
+#define USBIP_CLASS_DEFINE(n, _)						\
+	USBH_DEFINE_CLASS(usbip_##n, &usbip_class_api, &default_bus_ctx.devs[n], NULL)
+
+LISTIFY(CONFIG_USBIP_DEVICES_COUNT, USBIP_CLASS_DEFINE, ())
+
+/* The controller, for the transfers of a device that may be gone */
+static const struct device *usbip_uhc(void)
+{
+	return usbip_uhs_ctx.dev;
+}
+
+/* Cancel the transfers a session has in flight: they complete with -ECONNRESET */
+static void usbip_dequeue_all(struct usbip_dev_ctx *const dev_ctx)
+{
+	struct usbip_cmd_node *cmd_nd;
+	unsigned int key;
+
+	key = irq_lock();
+	SYS_DLIST_FOR_EACH_CONTAINER(&dev_ctx->dlist, cmd_nd, node) {
+		(void)uhc_ep_dequeue(usbip_uhc(), cmd_nd->xfer);
+	}
+	irq_unlock(key);
+}
+
 static ALWAYS_INLINE int usbip_send(int sock, const void *const buf, const size_t len)
 {
 	return zsock_send_all(sock, buf, len, 0, K_FOREVER, NULL);
@@ -154,7 +209,9 @@ static int usbip_req_cb(struct usb_device *const udev, struct uhc_transfer *cons
 		goto usbip_req_cb_error;
 	}
 
-	if (!k_event_wait(&dev_ctx->event, USBIP_EXPORTED, false, K_NO_WAIT)) {
+	/* The session is over, or another one has started, or the device is gone */
+	if (k_event_test(&dev_ctx->event, USBIP_EXPORTED | USBIP_REMOVED) != USBIP_EXPORTED ||
+	    cmd_nd->session != dev_ctx->session) {
 		LOG_WRN("Connection closed, drop completed seqnum %u", cmd->hdr.seqnum);
 		goto usbip_req_cb_error;
 	}
@@ -173,7 +230,7 @@ static int usbip_req_cb(struct usb_device *const udev, struct uhc_transfer *cons
 
 
 	if (USB_EP_GET_IDX(xfer->ep) == 0U) {
-		check_ctrl_request(dev_ctx->udev, xfer->ep, xfer->setup_pkt);
+		check_ctrl_request(udev, xfer->ep, xfer->setup_pkt);
 	}
 
 	err = usbip_send(dev_ctx->connfd, &ret, sizeof(ret));
@@ -231,6 +288,10 @@ static int usbip_submit_req(struct usbip_cmd_node *const cmd_nd, const uint8_t e
 		}
 	} while (xfer == NULL && retry--);
 
+	if (xfer == NULL) {
+		return -ENOMEM;
+	}
+
 	if (setup != NULL) {
 		memcpy(xfer->setup_pkt, setup, sizeof(struct usb_setup_packet));
 		LOG_HEXDUMP_DBG(xfer->setup_pkt, 8U, "setup");
@@ -265,6 +326,7 @@ static int usbip_handle_submit(struct usbip_dev_ctx *const dev_ctx,
 	struct usb_setup_packet setup = {0};
 	struct usbip_cmd_node *cmd_nd;
 	struct net_buf *buf = NULL;
+	unsigned int key;
 	uint8_t ep;
 	int ret;
 
@@ -278,7 +340,7 @@ static int usbip_handle_submit(struct usbip_dev_ctx *const dev_ctx,
 	ep = cmd->hdr.ep;
 	if (cmd->submit.length != 0) {
 		if (USB_EP_GET_IDX(ep) == 0U) {
-			buf = usbh_xfer_buf_alloc(dev_ctx->udev, cmd->submit.length);
+			buf = uhc_xfer_buf_alloc(usbip_uhc(), cmd->submit.length);
 		} else {
 			buf = net_buf_alloc_len(&usbip_pool, cmd->submit.length, K_NO_WAIT);
 		}
@@ -325,11 +387,35 @@ static int usbip_handle_submit(struct usbip_dev_ctx *const dev_ctx,
 	/* Make a copy of the command and add it to the backlog */
 	memcpy(&cmd_nd->cmd, cmd, sizeof(struct usbip_command));
 	cmd_nd->ctx = dev_ctx;
-	sys_dlist_append(&dev_ctx->dlist, &cmd_nd->node);
+	cmd_nd->session = dev_ctx->session;
+
+	/* The device stays until the transfer is queued: its removal cancels it then */
+	k_mutex_lock(&dev_ctx->lock, K_FOREVER);
+
+	if (dev_ctx->udev == NULL || k_event_test(&dev_ctx->event, USBIP_REMOVED)) {
+		ret = -ENODEV;
+	} else {
+		key = irq_lock();
+		sys_dlist_append(&dev_ctx->dlist, &cmd_nd->node);
+		irq_unlock(key);
+
+		ret = usbip_submit_req(cmd_nd, ep, &setup, buf);
+		if (ret != 0) {
+			key = irq_lock();
+			sys_dlist_remove(&cmd_nd->node);
+			irq_unlock(key);
+		}
+	}
+
+	k_mutex_unlock(&dev_ctx->lock);
 
-	ret = usbip_submit_req(cmd_nd, ep, &setup, buf);
 	if (ret != 0) {
 		LOG_ERR("Failed to submit request %d", ret);
+		k_mem_slab_free(&usbip_slab, (void *)cmd_nd);
+		if (buf != NULL) {
+			net_buf_unref(buf);
+		}
+
 		return ret;
 	}
 
@@ -369,7 +455,7 @@ static int usbip_handle_unlink(struct usbip_dev_ctx *const dev_ctx,
 	SYS_DLIST_FOR_EACH_CONTAINER(&dev_ctx->dlist, cmd_nd, node) {
 		if (cmd_nd->cmd.hdr.seqnum == cmd->unlink.seqnum) {
 			rsp.unlink.status = net_htonl(-ECONNRESET);
-			usbh_xfer_dequeue(dev_ctx->udev, cmd_nd->xfer);
+			(void)uhc_ep_dequeue(usbip_uhc(), cmd_nd->xfer);
 			break;
 		}
 	}
@@ -380,9 +466,30 @@ static int usbip_handle_unlink(struct usbip_dev_ctx *const dev_ctx,
 
 static int usbip_handle_cmd(struct usbip_dev_ctx *const dev_ctx)
 {
+	struct zsock_pollfd pfd = {
+		.fd = dev_ctx->connfd,
+		.events = ZSOCK_POLLIN,
+	};
 	struct usbip_command cmd;
 	int ret;
 
+	/*
+	 * Wait for the next command, and end the session once its device is
+	 * gone: the removal shuts the socket down for reading, which wakes
+	 * this up, and where the socket does not support that, the next
+	 * check does.
+	 */
+	do {
+		if (k_event_test(&dev_ctx->event, USBIP_REMOVED)) {
+			return -ENODEV;
+		}
+
+		ret = zsock_poll(&pfd, 1, USBIP_IDLE_CHECK_MS);
+		if (ret < 0) {
+			return -errno;
+		}
+	} while (ret == 0);
+
 	ret = zsock_recv(dev_ctx->connfd, &cmd.hdr, sizeof(cmd.hdr), ZSOCK_MSG_WAITALL);
 	if (ret <= 0) {
 		return ret == 0 ? -ENOTCONN : -errno;
@@ -405,6 +512,21 @@ static int usbip_handle_cmd(struct usbip_dev_ctx *const dev_ctx)
 	return ret;
 }
 
+static void usbip_session_end(struct usbip_dev_ctx *const dev_ctx)
+{
+	k_mutex_lock(&dev_ctx->lock, K_FOREVER);
+
+	/* What the client left in flight; if the device is gone, that is done */
+	if (!k_event_test(&dev_ctx->event, USBIP_REMOVED)) {
+		usbip_dequeue_all(dev_ctx);
+	}
+
+	zsock_close(dev_ctx->connfd);
+	k_event_clear(&dev_ctx->event, USBIP_EXPORTED);
+
+	k_mutex_unlock(&dev_ctx->lock);
+}
+
 static void usbip_thread_cmd(void *const a, void *const b, void *const c)
 {
 	struct usbip_dev_ctx *dev_ctx = a;
@@ -417,152 +539,213 @@ static void usbip_thread_cmd(void *const a, void *const b, void *const c)
 		ret = usbip_handle_cmd(dev_ctx);
 
 		if (ret) {
-			zsock_close(dev_ctx->connfd);
+			usbip_session_end(dev_ctx);
 			LOG_INF("CMD connection closed, errno %d", ret);
-			k_event_set_masked(&dev_ctx->event, 0, USBIP_EXPORTED);
 		}
 	}
 }
 
