From d7fe49eea3e2d1ef42e7c0ce8f7b60829c95e8f8 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Benjamin=20Cab=C3=A9?= <benjamin@zephyrproject.org>
Date: Mon, 19 Oct 2026 13:28:28 +0200
Subject: [PATCH 6/7] usb: usbip: close the connection when the exported device
 is removed
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

When the exported device is disconnected, the client is not notified
and the connection remains open. Dequeue the pending transfers and shut
down the socket for reading, which wakes up the thread waiting for the
next command, so that it closes the connection. The offloaded sockets of
native_sim do not support shutdown, the thread therefore also checks
for the removal every 250 ms while waiting.

Assisted-by: Claude:opus-5.5
Signed-off-by: Benjamin Cabé <benjamin@zephyrproject.org>
---
 subsys/usb/host/usbip.c | 57 +++++++++++++++++++++++++++++++++++++----
 1 file changed, 52 insertions(+), 5 deletions(-)

diff --git a/subsys/usb/host/usbip.c b/subsys/usb/host/usbip.c
index 9a6bdcd48..5896ba542 100644
--- a/subsys/usb/host/usbip.c
+++ b/subsys/usb/host/usbip.c
@@ -40,6 +40,11 @@ static struct k_thread usbip_thread;
 #define USBIP_DEFAULT_PATH	"/sys/bus/usb/devices/usb1/"
 
 #define USBIP_EXPORTED		BIT(0)
+/* The exported device has been removed */
+#define USBIP_REMOVED		BIT(1)
+
+/* How often a connection waiting for a command checks for the device removal */
+#define USBIP_IDLE_CHECK_MS	250
 
 /*
  * Context of the exported device. It is a host class instance, the host
@@ -182,7 +187,7 @@ static int usbip_req_cb(struct usb_device *const udev, struct uhc_transfer *cons
 		goto usbip_req_cb_error;
 	}
 
-	if (!k_event_wait(&dev_ctx->event, USBIP_EXPORTED, false, K_NO_WAIT) ||
+	if (k_event_test(&dev_ctx->event, USBIP_EXPORTED | USBIP_REMOVED) != USBIP_EXPORTED ||
 	    cmd_nd->session != dev_ctx->session) {
 		LOG_WRN("Connection closed, drop completed seqnum %u", cmd->hdr.seqnum);
 		goto usbip_req_cb_error;
@@ -368,7 +373,7 @@ static int usbip_handle_submit(struct usbip_dev_ctx *const dev_ctx,
 	/* The device cannot be removed until the transfer is queued */
 	k_mutex_lock(&dev_ctx->lock, K_FOREVER);
 
-	if (dev_ctx->udev == NULL) {
+	if (dev_ctx->udev == NULL || k_event_test(&dev_ctx->event, USBIP_REMOVED)) {
 		ret = -ENODEV;
 	} else {
 		key = irq_lock();
@@ -442,9 +447,29 @@ static int usbip_handle_unlink(struct usbip_dev_ctx *const dev_ctx,
 
 static int usbip_handle_cmd(struct usbip_dev_ctx *const dev_ctx)
 {
+	struct zsock_pollfd pfd = {
+		.fd = dev_ctx->connfd,
+		.events = ZSOCK_POLLIN,
+	};
 	struct usbip_command cmd;
 	int ret;
 
+	/*
+	 * Wait for the next command. The removal of the device shuts the
+	 * socket down for reading, which ends the wait. Not all sockets
+	 * support it, check for the removal periodically as well.
+	 */
+	do {
+		if (k_event_test(&dev_ctx->event, USBIP_REMOVED)) {
+			return -ENODEV;
+		}
+
+		ret = zsock_poll(&pfd, 1, USBIP_IDLE_CHECK_MS);
+		if (ret < 0) {
+			return -errno;
+		}
+	} while (ret == 0);
+
 	ret = zsock_recv(dev_ctx->connfd, &cmd.hdr, sizeof(cmd.hdr), ZSOCK_MSG_WAITALL);
 	if (ret <= 0) {
 		return ret == 0 ? -ENOTCONN : -errno;
@@ -480,6 +505,21 @@ static void usbip_dequeue_all(struct usbip_dev_ctx *const dev_ctx)
 	irq_unlock(key);
 }
 
+static void usbip_close(struct usbip_dev_ctx *const dev_ctx)
+{
+	k_mutex_lock(&dev_ctx->lock, K_FOREVER);
+
+	/* On removal, the pending transfers have already been dequeued */
+	if (!k_event_test(&dev_ctx->event, USBIP_REMOVED)) {
+		usbip_dequeue_all(dev_ctx);
+	}
+
+	zsock_close(dev_ctx->connfd);
+	k_event_clear(&dev_ctx->event, USBIP_EXPORTED);
+
+	k_mutex_unlock(&dev_ctx->lock);
+}
+
 static void usbip_thread_cmd(void *const a, void *const b, void *const c)
 {
 	struct usbip_dev_ctx *dev_ctx = a;
@@ -492,10 +532,8 @@ static void usbip_thread_cmd(void *const a, void *const b, void *const c)
 		ret = usbip_handle_cmd(dev_ctx);
 
 		if (ret) {
-			usbip_dequeue_all(dev_ctx);
-			zsock_close(dev_ctx->connfd);
+			usbip_close(dev_ctx);
 			LOG_INF("CMD connection closed, errno %d", ret);
-			k_event_set_masked(&dev_ctx->event, 0, USBIP_EXPORTED);
 		}
 	}
 }
@@ -531,6 +569,14 @@ static int usbip_class_removed(struct usbh_class_data *const c_data)
 	struct usbip_dev_ctx *const dev_ctx = c_data->priv;
 
 	k_mutex_lock(&dev_ctx->lock, K_FOREVER);
+
+	if (k_event_test(&dev_ctx->event, USBIP_EXPORTED)) {
+		/* Reading from the socket returns end of file, the connection is closed */
+		usbip_dequeue_all(dev_ctx);
+		k_event_post(&dev_ctx->event, USBIP_REMOVED);
+		(void)zsock_shutdown(dev_ctx->connfd, ZSOCK_SHUT_RD);
+	}
+
 	dev_ctx->udev = NULL;
 	k_mutex_unlock(&dev_ctx->lock);
 
@@ -734,6 +780,7 @@ static int usbip_handle_import(struct usbip_bus_ctx *const bus_ctx, int connfd)
 	k_mutex_lock(&dev_ctx->lock, K_FOREVER);
 	dev_ctx->connfd = connfd;
 	dev_ctx->session++;
+	k_event_clear(&dev_ctx->event, USBIP_REMOVED);
 	k_event_post(&dev_ctx->event, USBIP_EXPORTED);
 	k_mutex_unlock(&dev_ctx->lock);
 

From aa2418d4f108d71340635c9aec2b483cf2e2fae8 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Benjamin=20Cab=C3=A9?= <benjamin@zephyrproject.org>
Date: Mon, 19 Oct 2026 13:28:28 +0200
Subject: [PATCH 7/7] usb: usbip: name devices by their port
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The bus ID is "1-<address>", and the address changes when a device is
enumerated again. Behind a hub, two devices that reset at the same time
can swap their bus IDs, and a client that attaches again gets the other
device.

Name a device by its place on the bus, as Linux does: "1-1" on the root
port, "1-1.3" on port 3 of a hub there, and so on. A device on the root
port keeps the bus ID it usually had.

Assisted-by: Claude:opus-5.5
Signed-off-by: Benjamin Cabé <benjamin@zephyrproject.org>
---
 subsys/usb/host/usbip.c | 22 +++++++++++++++++++++-
 1 file changed, 21 insertions(+), 1 deletion(-)

diff --git a/subsys/usb/host/usbip.c b/subsys/usb/host/usbip.c
index 5896ba542..87570d545 100644
--- a/subsys/usb/host/usbip.c
+++ b/subsys/usb/host/usbip.c
@@ -39,6 +39,9 @@ static struct k_thread usbip_thread;
 
 #define USBIP_DEFAULT_PATH	"/sys/bus/usb/devices/usb1/"
 
+/* Hubs between the root port and a device, at most (USB 2.0, 4.1.1) */
+#define USBIP_HUB_TIERS_MAX	5
+
 #define USBIP_EXPORTED		BIT(0)
 /* The exported device has been removed */
 #define USBIP_REMOVED		BIT(1)
@@ -585,10 +588,27 @@ static int usbip_class_removed(struct usbh_class_data *const c_data)
 	return 0;
 }
 
+/*
+ * Name the device by its place on the bus, as Linux does: "1-1" on the root
+ * port, "1-1.3" on port 3 of a hub there, "1-1.3.2" one hub further. Unlike
+ * the address, it does not change when the device is enumerated again.
+ */
 static void usbip_busid(const struct usb_device *const udev, const uint32_t busnum,
 			char *const busid, const size_t len)
 {
-	snprintf(busid, len, "%u-%u", busnum, udev->addr);
+	const struct usb_device *dev = udev;
+	uint8_t ports[USBIP_HUB_TIERS_MAX];
+	size_t n = 0;
+	int pos;
+
+	for (; dev->hub != NULL && n < ARRAY_SIZE(ports); dev = dev->hub) {
+		ports[n++] = dev->hub_port;
+	}
+
+	pos = snprintf(busid, len, "%u-1", busnum);
+	while (n > 0 && pos > 0 && (size_t)pos < len) {
+		pos += snprintf(busid + pos, len - pos, ".%u", ports[--n]);
+	}
 }
 
 /* Device list entry, filled with the context lock held and sent without it */
